# ==============================================
# Deve-Note Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================

# --- Core System ---
# DEVE_PROFILE=standard
# DEVE_LEDGER_DIR=ledger
# DEVE_SYNC_MODE=auto

# --- Auth ---
# Local development shortcut:
# DEVE_ENV=development
#
# Production requires explicit auth material. Keep AUTH_SECRET >= 32 bytes and
# set AUTH_PASS to an Argon2 PHC password hash, not a plaintext password.
# AUTH_SECRET=replace-with-at-least-32-random-bytes
# AUTH_USER=admin
# AUTH_PASS=$argon2id$v=19$m=65536,t=3,p=1$...

# --- AI Chat Plugin ---
# [Required] The API key for your LLM provider
AI_API_KEY=sk-your-api-key-here

# [Optional] Base URL (e.g., for OpenRouter, DeepSeek, or local Ollama)
# Default: https://api.openai.com/v1
# Examples:
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_BASE_URL=http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# [Optional] Model Name
# Default: gpt-4o
AI_MODEL=gpt-4o

# [Optional] Extra Headers (JSON format)
# Useful for providers like OpenRouter that require site-url/app-name
# AI_EXTRA_HEADERS={"HTTP-Referer": "https://deve-note.com", "X-Title": "Deve-Note"}
