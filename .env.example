# ==============================================
# Deve-Note Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================

# --- Core System ---
# DEVE_PROFILE=standard
# DEVE_LEDGER_DIR=ledger
# DEVE_SYNC_MODE=auto

# --- Auth ---
# Local development shortcut:
# DEVE_ENV=development
#
# Production requires explicit auth material. Keep AUTH_SECRET >= 32 bytes and
# set AUTH_PASS to an Argon2 PHC password hash, not a plaintext password.
# AUTH_SECRET=replace-with-at-least-32-random-bytes
# AUTH_USER=admin
# AUTH_PASS=$argon2id$v=19$m=65536,t=3,p=1$...
#
# Development-only loopback shortcut. This is rejected unless DEVE_ENV=development.
# AUTH_ALLOW_ANONYMOUS_LOCALHOST=false

# --- Native AI provider (optional deployment-managed override) ---
# Leave all AI variables commented to manage them through `AI: Settings`, which
# persists only to data/ai.env. Any non-empty variable below makes the entire
# provider section read-only; Compose never writes back to this project file.
# AI_PROVIDER=openai-chat-completions
# AI_API_KEY=replace-with-provider-key

# [Optional] Base URL (e.g., for OpenRouter, DeepSeek, or local Ollama)
# Default: https://api.openai.com/v1
# Examples:
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_BASE_URL=http://localhost:11434/v1
# AI_BASE_URL=https://api.openai.com/v1

# [Optional] Model Name
# Default: gpt-4o-mini
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=4096
