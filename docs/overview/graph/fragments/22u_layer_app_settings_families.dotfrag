            app_settings_file_create [label="init::write_config", fillcolor="#bfdbfe"];
            app_settings_file_edit [label="config::file_value", fillcolor="#bfdbfe"];
            app_settings_file_apply [label="config::load_checked", fillcolor="#bfdbfe"];
            app_settings_ui_locale [label="settings::locale_select", fillcolor="#bfdbfe"];
            app_settings_ui_sync [label="settings::sync_mode_select", fillcolor="#bfdbfe"];
            app_settings_ui_ai [label="settings::ai_backend_select", fillcolor="#bfdbfe"];
            app_settings_feedback_visual [label="settings::visual_feedback", fillcolor="#eff6ff"];
