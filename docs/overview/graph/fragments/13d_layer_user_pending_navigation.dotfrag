                op_nav_continue [label="Confirm Leave", fillcolor="#fde68a"];
                op_nav_clear [label="Clear Guard On Confirmed Edit", fillcolor="#fef9c3"];
                gate_nav_pending [label="Navigation Guard:\ncurrent doc pending set\nnot global pending", fillcolor="#fde68a", shape=note];
            }
