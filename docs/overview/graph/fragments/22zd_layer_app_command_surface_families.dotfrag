        subgraph cluster_app_command_surface {
            label="command surface shared interfaces [14_commands]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_command_surface_open [label="search_surface::open", fillcolor="#eff6ff"];
            app_command_surface_mode [label="create_results_memo mode router", fillcolor="#bfdbfe"];
            app_command_surface_results [label="SearchProvider::search", fillcolor="#eff6ff"];
            app_command_surface_select [label="search_result::select", fillcolor="#eff6ff"];
            app_command_surface_dispatch [label="execute_action(SearchAction)", fillcolor="#bfdbfe"];
            app_command_surface_handoff [label="SearchAction -> downstream flow", fillcolor="#dbeafe"];
        }
