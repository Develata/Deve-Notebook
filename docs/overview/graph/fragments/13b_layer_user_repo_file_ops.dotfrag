            subgraph cluster_user_repo_file_ops {
                label="repo file operations [04_repository + 11_ui_design]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_fileops_open [label="Open File Operation Surface", fillcolor="#fef9c3"];
                op_fileops_path [label="Type File Operation Path", fillcolor="#fef9c3"];
                op_fileops_create [label="Submit CreateDoc", fillcolor="#fde68a"];
                op_fileops_pathop [label="Submit Rename / Copy / Move / Delete", fillcolor="#fde68a"];
                op_fileops_result [label="Receive File Operation Result", fillcolor="#fef9c3"];
                gate_fileops [label="Write Gates:\nlocal repo\nscope_nonce valid\nnot readonly", fillcolor="#fde68a", shape=note];
            }

