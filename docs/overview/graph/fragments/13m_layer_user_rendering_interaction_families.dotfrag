            subgraph cluster_user_render_checkbox {
                label="rendering checkbox writeback [03_rendering]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_render_checkbox_click [label="Click Task Checkbox", fillcolor="#fde68a"];
                op_render_checkbox_widget [label="Observe Checkbox Widget State", fillcolor="#fef9c3"];
                op_render_checkbox_source [label="Observe Task Source Writeback", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_render_link_activation {
                label="rendering link activation gate [03_rendering]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_render_link_press [label="Press Ctrl/Cmd Modifier", fillcolor="#fde68a"];
                op_render_link_click [label="Click Armed Link", fillcolor="#fde68a"];
                op_render_link_release [label="Release Ctrl/Cmd Modifier", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_render_outline_navigation {
                label="rendering outline navigation [03_rendering]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_render_outline_toggle [label="Toggle Outline Panel", fillcolor="#fef9c3"];
                op_render_outline_select [label="Select Outline Heading", fillcolor="#fde68a"];
                op_render_outline_observe [label="Observe Editor At Heading Target", fillcolor="#fef9c3"];
            }
