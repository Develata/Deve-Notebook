            app_settings_mutation_cli [label="settings::mutate_cli", fillcolor="#eff6ff"];
            app_settings_persist_write [label="settings::write_config", fillcolor="#bfdbfe"];
            app_settings_persist_apply [label="settings::apply_config", fillcolor="#bfdbfe"];
