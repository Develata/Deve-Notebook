    subgraph cluster_object_plane {
        label="Object Plane - Sidecar State / Authority Objects";
        style="filled,rounded,dashed";
        fillcolor="#f8fafc";
        color="#64748b";
        labelfontcolor="#334155";

        subgraph cluster_obj_doc {
            label="document objects";
            style="rounded,filled";
            fillcolor="#f8fafc";
            color="#94a3b8";

            obj_doc_content [label="doc::content", fillcolor="#f8fafc"];
            obj_confirmed_op [label="confirmed_op", fillcolor="#f8fafc"];
            obj_pending_local_edit [label="pending_local_edit", fillcolor="#f8fafc"];
            obj_pending_navigation [label="pending_navigation", fillcolor="#f8fafc"];
        }

        subgraph cluster_obj_repo {
            label="repo / sync objects";
            style="rounded,filled";
            fillcolor="#f8fafc";
            color="#94a3b8";

            obj_repo_scope [label="repo::scope", fillcolor="#f8fafc"];
