        subgraph cluster_core_sc_conflict {
            label="resolve conflict [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sc_conflict [label="source control\n(workflow)", fillcolor="#fdf2f8"];
            core_sync_conflict [label="sync\n(runtime)", fillcolor="#fdf2f8"];
            core_ledger_conflict [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_proto_conflict [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }
