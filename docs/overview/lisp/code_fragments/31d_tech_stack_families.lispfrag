(module :id mod_heavy_feature_gate :label "runtime::heavy_feature_gate" :parent core.tech_stack :code "docs/features/14_tech_stack.md | release checklist")
(module :id mod_release_channel :label "release::channel" :parent core.release :code ".github/workflows/release.yml | dist/")
(module :id mod_container_delivery :label "release::container_delivery" :parent core.release :code "Dockerfile | docker-compose.yml")
(group :id grp.core.tech-dependency :layer core :label "tech-stack dependency policy" :members (core.tech_stack))
(group :id grp.core.tech-budget :layer core :label "tech-stack runtime budget check" :members (core.tech_stack core.release core.settings))
