(group :id grp.mod.tech-dependency :layer module :label "tech-stack dependency policy" :members (mod_tech_manifest mod_tech_lockfile mod_tech_policy_review mod_tech_deps))
(group :id grp.mod.tech-budget :layer module :label "tech-stack runtime budget check" :members (mod_runtime_profile_gate mod_runtime_budget mod_heavy_feature_gate mod_config_runtime mod_ci_release))
