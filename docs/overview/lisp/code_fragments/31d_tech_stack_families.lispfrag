(module :id mod_tech_manifest :label "tech::manifest" :parent core.tech_stack :code "Cargo.toml | apps/web/package.json")
(module :id mod_tech_lockfile :label "tech::lockfile" :parent core.tech_stack :code "Cargo.lock | apps/web/package-lock.json")
(module :id mod_tech_policy_review :label "tech::policy_review" :parent core.tech_stack :code "docs/features/14_tech_stack.md | PR review")
