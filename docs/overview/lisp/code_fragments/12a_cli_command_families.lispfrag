(group :id grp.user.cli-vault :layer user-operation :label "CLI vault indexing" :members (op.cli.vault.choose-init-path op.cli.vault.run-scan op.cli.vault.watch-dry-run))
(group :id grp.user.cli-server :layer user-operation :label "CLI server runtime" :members (op.cli.server.choose-port op.cli.server.enable-dev-mode op.cli.server.dry-run op.cli.server.start))
(group :id grp.user.cli-export :layer user-operation :label "CLI export / inspect" :members (op.cli.inspect.dump-path op.cli.export.choose-format op.cli.export.select-doc op.cli.export.choose-output))
(group :id grp.user.cli-repair :layer user-operation :label "CLI repair / admin" :members (op.cli.admin.verify-p2p op.cli.admin.seed-peer op.cli.admin.check-node op.cli.admin.recover-repo op.cli.admin.repair-paths))
(user-operation :id op.cli.vault.choose-init-path :label "Choose Init Path" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Init.path" :calls (app.cli.vault.init))
(user-operation :id op.cli.vault.run-scan :label "Run Vault Scan" :kind cli-command :surface cli :code "apps/cli/src/main.rs::Commands::Scan" :calls (app.cli.vault.scan))
(user-operation :id op.cli.vault.watch-dry-run :label "Watch Vault Dry Run" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Watch.dry_run" :calls (app.cli.vault.watch))
(user-operation :id op.cli.server.choose-port :label "Choose Server Port" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Serve.port" :calls (app.cli.server.bind))
(user-operation :id op.cli.server.enable-dev-mode :label "Enable Dev Mode" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Serve.dev" :calls (app.cli.server.dev))
(user-operation :id op.cli.server.dry-run :label "Dry Run Server Startup" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Serve.dry_run" :calls (app.cli.server.dry-run))
(user-operation :id op.cli.server.start :label "Start Local Hub" :kind cli-command :surface cli :code "apps/cli/src/dispatch.rs::Commands::Serve" :calls (app.cli.server.start))
(user-operation :id op.cli.inspect.dump-path :label "Dump File Ops" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Dump" :calls (app.cli.inspect.dump))
(user-operation :id op.cli.export.choose-format :label "Choose Export Format" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Export.format" :calls (app.cli.export.format))
(user-operation :id op.cli.export.select-doc :label "Select Export Document" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Export.doc" :calls (app.cli.export.doc))
(user-operation :id op.cli.export.choose-output :label "Choose Export Output" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Export.output" :calls (app.cli.export.output))
(user-operation :id op.cli.admin.verify-p2p :label "Verify P2P Logic" :kind cli-command :surface cli :code "apps/cli/src/main.rs::Commands::VerifyP2P" :calls (app.cli.admin.verify-p2p))
(user-operation :id op.cli.admin.seed-peer :label "Seed Peer Data" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Seed.peer" :calls (app.cli.admin.seed))
(user-operation :id op.cli.admin.check-node :label "Check Node Consistency" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::NodeCheck" :calls (app.cli.admin.node-check))
(user-operation :id op.cli.admin.recover-repo :label "Recover Repo Files" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Recover.repo" :calls (app.cli.admin.recover))
(user-operation :id op.cli.admin.repair-paths :label "Repair Known Local Corruption" :kind cli-option :surface cli :code "apps/cli/src/main.rs::Commands::Repair" :calls (app.cli.admin.repair))
