(group :id grp.mod.settings-env :layer module :label "settings env defaults" :members (mod_config_defaults mod_config_env mod_config_runtime mod_runtime_profile))
(group :id grp.mod.settings-file :layer module :label "settings file config" :members (mod_config_file mod_config_runtime mod_runtime_profile mod_cli_init))
(group :id grp.mod.settings-ui :layer module :label "settings UI preferences" :members (mod_settings_ui mod_i18n_catalog mod_sync_mode_control mod_ai_backend_capability))
(group :id grp.mod.settings-feedback :layer module :label "settings runtime feedback" :members (mod_settings_feedback mod_settings_ui mod_runtime_profile mod_ai_backend_capability))
(module :id mod_config_defaults :label "config::defaults" :parent core.settings :code "crates/core/src/config.rs default_*")
(module :id mod_config_env :label "config::env" :parent core.settings :code "config::Environment::with_prefix(\"DEVE\")")
(module :id mod_config_file :label "config::file" :parent core.settings :code "config.toml via config::File::with_name(\"config\")")
(module :id mod_runtime_profile :label "runtime::profile" :parent core.settings :code "apps/cli/src/main.rs | apps/cli/src/server/mod.rs")
(module :id mod_sync_mode_control :label "settings::sync_mode" :parent core.sync :code "apps/web/src/components/settings_sections.rs")
(module :id mod_ai_backend_capability :label "settings::ai_backend_capability" :parent core.plugin :code "apps/web/src/components/settings_sections.rs | apps/cli/src/server/agent_bridge/")
(module :id mod_settings_feedback :label "settings::feedback" :parent core.settings :code "apps/web/src/components/settings*.rs")
(group :id grp.core.settings-env :layer core :label "settings env defaults" :members (core.settings core.commands))
(group :id grp.core.settings-file :layer core :label "settings file config" :members (core.settings core.commands))
(group :id grp.core.settings-ui :layer core :label "settings UI preferences" :members (core.settings core.i18n core.sync core.plugin))
(group :id grp.core.settings-feedback :layer core :label "settings runtime feedback" :members (core.settings core.i18n core.plugin core.tech_stack))
