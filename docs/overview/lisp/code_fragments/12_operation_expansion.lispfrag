(group :id grp.user.release-ci :layer user-operation :label "release / CI" :members (op.release.ci.push-tag op.release.ci.run-quality-gates op.release.ci.publish-container op.release.ci.inspect-channel-coverage))
(group :id grp.user.cli-control :layer user-operation :label "CLI control commands" :members (op.cli.control.invoke-command op.cli.control.execute-runtime op.cli.control.inspect-help))
(group :id grp.user.settings-update :layer user-operation :label "settings update" :members (op.settings.open-surface op.settings.change-value op.settings.observe-feedback))
(group :id grp.user.render-cursor :layer user-operation :label "rendering cursor reveal" :members (op.render.cursor.enter-token op.render.cursor.edit-source op.render.cursor.leave-token))
(group :id grp.user.render-math-mermaid :layer user-operation :label "rendering math / mermaid" :members (op.render.math.type-source op.render.mermaid.type-source op.render.projection.edit-source))
(group :id grp.user.i18n-locale-error :layer user-operation :label "i18n locale / error" :members (op.i18n.select-locale op.i18n.receive-error-code op.i18n.observe-format))
(group :id grp.user.tech-runtime-budget :layer user-operation :label "tech-stack runtime budget" :members (op.tech.inspect-dependencies op.tech.run-budget-check op.tech.inspect-platform-maturity))
(user-operation :id op.release.ci.push-tag :label "Push Release Tag" :kind git-event :surface git :code ".github/workflows/release.yml" :calls (app.release.ci.dispatch))
(user-operation :id op.release.ci.run-quality-gates :label "Run Release Quality Gates" :kind ci-job :surface github-actions :code ".github/workflows/release.yml" :calls (app.release.ci.quality))
(user-operation :id op.release.ci.publish-container :label "Publish Release Container" :kind ci-job :surface github-actions :code ".github/workflows/release.yml" :calls (app.release.ci.publish))
(user-operation :id op.release.ci.inspect-channel-coverage :label "Inspect Channel Coverage" :kind inspection :surface repo-files :code ".github/workflows/ (release.yml exists; nightly.yml and speckit-sync-check.yml absent)" :calls (app.release.ci.coverage))
(user-operation :id op.cli.control.invoke-command :label "Invoke CLI Command" :kind cli-invoke :surface cli :code "apps/cli/src/main.rs | apps/cli/src/dispatch.rs" :calls (app.cli.control.parse))
(user-operation :id op.cli.control.execute-runtime :label "Execute CLI Runtime Command" :kind execute :surface cli :code "apps/cli/src/dispatch.rs | apps/cli/src/commands/" :calls (app.cli.control.dispatch))
(user-operation :id op.cli.control.inspect-help :label "Inspect CLI Help" :kind help :surface cli :code "apps/cli/src/main.rs" :calls (app.cli.control.help))
(user-operation :id op.settings.open-surface :label "Open Settings Surface" :kind open :surface settings-or-command-palette :code "apps/web/src/components/settings.rs | apps/web/src/components/settings_sections.rs" :calls (app.settings.open))
(user-operation :id op.settings.change-value :label "Change Setting Value" :kind select :surface settings-panel-or-cli :code "apps/web/src/components/settings_sections.rs | apps/cli/src/dispatch.rs" :calls (app.settings.change))
(user-operation :id op.settings.observe-feedback :label "Observe Setting Feedback" :kind async-result :surface workspace-shell :code "apps/web/src/components/settings.rs | crates/core/src/config.rs" :calls (app.settings.feedback))
(user-operation :id op.render.cursor.enter-token :label "Enter Rendered Token" :kind cursor-move :surface editor :code "apps/web/js/extensions/inline_renderer.js | apps/web/src/editor/" :calls (app.render.cursor.selection))
(user-operation :id op.render.cursor.edit-source :label "Edit Revealed Source" :kind text-input :surface editor :code "apps/web/src/editor/{delta_input.rs,delta_input_forward.rs}" :calls (app.render.cursor.delta))
(user-operation :id op.render.cursor.leave-token :label "Leave Rendered Token" :kind cursor-move :surface editor :code "apps/web/js/extensions/inline_renderer.js" :calls (app.render.cursor.restore))
(user-operation :id op.render.math.type-source :label "Type Math Source" :kind text-input :surface editor :code "apps/web/js/extensions/inline_renderer.js | apps/web/src/components/outline_render/katex.rs" :calls (app.render.math.source))
(user-operation :id op.render.mermaid.type-source :label "Type Mermaid Source" :kind text-input :surface editor :code "apps/web/js/extensions/inline_renderer.js | apps/web/package.json" :calls (app.render.mermaid.source))
(user-operation :id op.render.projection.edit-source :label "Edit Render Projection Source" :kind text-input :surface editor :code "apps/web/src/editor/delta_input.rs | apps/web/js/extensions/inline_renderer.js" :calls (app.render.projection.refresh))
(user-operation :id op.i18n.select-locale :label "Select Locale" :kind select :surface settings-or-browser :code "apps/web/src/i18n/ | apps/web/src/components/settings_sections.rs" :calls (app.i18n.locale.resolve))
(user-operation :id op.i18n.receive-error-code :label "Receive Error Code" :kind async-result :surface api-or-websocket :code "apps/web/src/i18n/server_error.rs | crates/core/src/protocol/" :calls (app.i18n.error.map))
(user-operation :id op.i18n.observe-format :label "Observe Localized Format" :kind observe :surface workspace-shell :code "apps/web/src/utils/time.rs | apps/web/src/i18n/" :calls (app.i18n.format.resolve))
(user-operation :id op.tech.inspect-dependencies :label "Inspect Dependency Set" :kind inspection :surface repo-files :code "Cargo.toml | apps/web/package.json" :calls (app.tech.inspect))
(user-operation :id op.tech.run-budget-check :label "Run Runtime Budget Check" :kind check :surface cli-or-ci :code "scripts/plan-coverage.sh | .github/workflows/release.yml" :calls (app.tech.budget))
(user-operation :id op.tech.inspect-platform-maturity :label "Inspect Platform Maturity" :kind inspection :surface docs-or-about-surface :code "docs/features/14_tech_stack.md | docs/features/15_release.md" :calls (app.tech.platform))
