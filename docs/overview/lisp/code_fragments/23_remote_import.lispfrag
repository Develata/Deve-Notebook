(group :id grp.app.remote-projection-push :layer application :label "remote projection push" :members (app.remote-projection.push))
(group :id grp.app.remote-import-prepare :layer application :label "remote import prepare" :members (app.remote-import.prepare))
(group :id grp.app.remote-import-review :layer application :label "remote import review" :members (app.remote-import.review))
(group :id grp.app.remote-import-apply :layer application :label "remote import apply" :members (app.remote-import.apply))
(group :id grp.app.remote-import-manage :layer application :label "remote import manage" :members (app.remote-import.manage))
(application :id app.remote-projection.push :label "remote projection push intent" :kind host-effect :code "apps/cli/src/remote_projection_transport/" :calls (mod_remote_projection_transport))
(application :id app.remote-import.prepare :label "immutable provider-bound prepare" :kind host-effect :code "apps/web/src/runtime/remote_import_client.rs -> apps/cli/src/remote_projection_transport/ -> apps/cli/src/remote_import_runtime.rs -> crates/core/src/remote_import/" :calls (mod_remote_import_client mod_remote_projection_transport mod_remote_import_runtime))
(application :id app.remote-import.review :label "backend-owned typed review" :kind query :code "apps/web/src/runtime/remote_import_client.rs -> apps/cli/src/server/handlers/remote_import/ -> crates/core/src/remote_import/facade/" :calls (mod_remote_import_runtime mod_remote_import_client))
(application :id app.remote-import.apply :label "mounted sealed apply and post-commit writeback" :kind authority-effect :code "apps/web/src/runtime/remote_import_client.rs; apps/cli/src/remote_import_runtime.rs; crates/core/src/ledger/manager/prepared_change_batch/remote_import.rs; crates/core/src/sync/remote_import_projection.rs" :calls (mod_remote_import_client mod_remote_import_runtime mod_remote_import_writer mod_projection_runtime))
(application :id app.remote-import.manage :label "typed refresh discard repair" :kind runtime-effect :code "apps/web/src/runtime/remote_import_client.rs; apps/cli/src/commands/remote_import/; apps/cli/src/server/handlers/remote_import/; crates/core/src/remote_import/" :calls (mod_remote_import_client mod_remote_import_runtime))
