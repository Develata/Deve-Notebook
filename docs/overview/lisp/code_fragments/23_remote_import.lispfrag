(group :id grp.app.remote-projection-push :layer application :label "remote projection push" :members (app.remote-projection.push))
(group :id grp.app.remote-import-prepare :layer application :label "remote import prepare" :members (app.remote-import.prepare))
(group :id grp.app.remote-import-review :layer application :label "remote import review" :members (app.remote-import.review))
(group :id grp.app.remote-import-apply :layer application :label "remote import apply" :members (app.remote-import.apply))
(group :id grp.app.remote-import-manage :layer application :label "remote import manage" :members (app.remote-import.manage))
(application :id app.remote-projection.push :label "remote projection push intent" :kind host-effect :code "apps/cli/src/remote_projection_transport/" :calls (mod_remote_projection_transport))
(application :id app.remote-import.prepare :label "source-to-workspace substitute" :kind drift-substitute :code "apps/cli/src/remote_projection_transport/ -> apps/cli/src/remote_projection_legacy/" :calls (mod_remote_projection_transport mod_remote_import_runtime))
(application :id app.remote-import.review :label "External Changes review substitute" :kind drift-substitute :code "apps/web/src/runtime/external_changes_client/" :calls (mod_remote_import_runtime mod_remote_import_client))
(application :id app.remote-import.apply :label "External Apply substitute" :kind drift-substitute :code "crates/core/src/source_control/external_apply.rs" :calls (mod_remote_import_runtime mod_remote_import_writer mod_projection_runtime))
(application :id app.remote-import.manage :label "missing durable session lifecycle" :kind drift-missing :code "planned/no-code-yet" :calls (mod_remote_import_runtime))
