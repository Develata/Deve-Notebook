(group :id grp.user.tech-dependency :layer user-operation :label "tech-stack dependency policy" :members (op.tech.deps.inspect-manifest op.tech.deps.inspect-lockfile op.tech.deps.evaluate-new))
(group :id grp.user.tech-budget :layer user-operation :label "tech-stack runtime budget check" :members (op.tech.budget.select-profile op.tech.budget.run-check op.tech.budget.review-heavy-feature))
(group :id grp.user.tech-platform :layer user-operation :label "tech-stack platform / release channel" :members (op.tech.platform.inspect-matrix op.tech.platform.verify-native-process-adapter op.tech.platform.verify-release-channel op.tech.platform.verify-container))
(user-operation :id op.tech.deps.inspect-manifest :label "Inspect Dependency Manifest" :kind inspection :surface repo-files :code "Cargo.toml | apps/web/package.json" :calls (app.tech.deps.manifest))
(user-operation :id op.tech.deps.inspect-lockfile :label "Inspect Dependency Lockfile" :kind inspection :surface repo-files :code "Cargo.lock | apps/web/package-lock.json" :calls (app.tech.deps.lockfile))
(user-operation :id op.tech.deps.evaluate-new :label "Evaluate New Dependency" :kind review :surface review :code "docs/plan/14_tech_stack.md | Cargo.toml review" :calls (app.tech.deps.evaluate))
(user-operation :id op.tech.budget.select-profile :label "Select Low-Spec Profile" :kind config-select :surface env-or-config :code "DEVE_PROFILE=low-spec | config.toml" :calls (app.tech.budget.profile))
(user-operation :id op.tech.budget.run-check :label "Run Runtime Budget Check" :kind check :surface cli-or-ci :code "scripts/plan-coverage.sh | .github/workflows/release.yml" :calls (app.tech.budget.check))
(user-operation :id op.tech.budget.review-heavy-feature :label "Review Heavy Feature Gate" :kind review :surface review :code "docs/plan/14_tech_stack.md | release checklist" :calls (app.tech.budget.gate))
(user-operation :id op.tech.platform.inspect-matrix :label "Inspect Platform Matrix" :kind inspection :surface docs-or-about-surface :code "docs/features/14_tech_stack.md | docs/features/15_release.md" :calls (app.tech.platform.matrix))
(user-operation :id op.tech.platform.verify-native-process-adapter :label "Verify Native Adapter Boundary" :kind check :surface cli-or-ci :code "crates/core/src/native_adapter/{process.rs,supervisor.rs,types.rs} | apps/{desktop,mobile}/src/{shell.rs,types.rs} | scripts/check-native-track-boundary.sh | scripts/check-native-packaging-gate.sh" :calls (app.tech.platform.native-process-adapter))
(user-operation :id op.tech.platform.verify-release-channel :label "Verify Release Channel" :kind check :surface ci-or-dist :code ".github/workflows/release.yml | dist/" :calls (app.tech.platform.channel))
(user-operation :id op.tech.platform.verify-container :label "Verify Container Delivery" :kind check :surface docker :code "Dockerfile | docker-compose.yml | .github/workflows/release.yml" :calls (app.tech.platform.container))
