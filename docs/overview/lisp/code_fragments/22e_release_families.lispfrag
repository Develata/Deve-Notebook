(group :id grp.app.release-tag :layer application :label "release tag dispatch" :members (app.release.tag.git-push app.release.tag.trigger-filter app.release.tag.workflow-dispatch))
(group :id grp.app.release-quality :layer application :label "release quality gates" :members (app.release.quality.test-job app.release.quality.clippy app.release.quality.web-wasm app.release.quality.dependency-audit app.release.quality.tests app.release.quality.runtime-happy-smoke app.release.quality.runtime-recovery-smoke app.release.quality.reliability-observability-baseline))
(group :id grp.app.release-publish :layer application :label "release artifact publish" :members (app.release.publish.registry-login app.release.publish.metadata app.release.publish.image-push app.release.publish.native-build app.release.publish.native-release))
(group :id grp.app.release-verify :layer application :label "release delivery verification" :members (app.release.verify.workflow-surface app.release.verify.channel-surface app.release.verify.container-smoke))
(application :id app.release.tag.git-push :label "git::push_tag" :kind git-event :code "git push origin vX.Y.Z" :calls (mod_release_tag_rule mod_ci_workflow))
(application :id app.release.tag.trigger-filter :label "release.yml::tag_filter" :kind ci-dispatch :code ".github/workflows/release.yml:on.push.tags" :calls (mod_release_tag_rule mod_ci_trigger))
(application :id app.release.tag.workflow-dispatch :label "release.yml::workflow_dispatch" :kind observe :code "GitHub Actions release run" :calls (mod_ci_trigger mod_ci_workflow))
(application :id app.release.quality.test-job :label "release.yml::test_job" :kind ci-job :code ".github/workflows/release.yml::jobs.test" :calls (mod_ci_release mod_quality_test_job))
(application :id app.release.quality.clippy :label "release.yml::clippy_gate" :kind ci-step :code ".github/workflows/release.yml::Run clippy" :calls (mod_quality_clippy mod_tech_budget))
(application :id app.release.quality.web-wasm :label "release.yml::web_wasm_gate" :kind ci-step :code ".github/workflows/release.yml::Check web WASM target | apps/web" :calls (mod_quality_web_wasm mod_tech_budget))
(application :id app.release.quality.dependency-audit :label "release.yml::dependency_audit" :kind ci-step :code ".github/workflows/release.yml::Audit dependencies | scripts/check-release-audit-gate.sh" :calls (mod_quality_dependency_audit mod_tech_budget))
(application :id app.release.quality.tests :label "release.yml::test_gate" :kind ci-step :code ".github/workflows/release.yml::Run tests" :calls (mod_quality_tests mod_tech_budget))
(application :id app.release.quality.runtime-happy-smoke :label "runtime::happy_path_smoke" :kind local-or-ci-script :code "scripts/smoke-runtime-happy-path.sh" :calls (mod_runtime_smoke mod_tech_budget))
(application :id app.release.quality.runtime-recovery-smoke :label "runtime::recovery_smoke" :kind local-or-ci-script :code "scripts/smoke-runtime-recovery-path.sh" :calls (mod_runtime_smoke mod_tech_budget))
(application :id app.release.quality.reliability-observability-baseline :label "reliability_observability::baseline" :kind local-or-ci-script :code "scripts/check-reliability-observability-baseline.sh | tools/baseline/src/reliability_observability.rs" :calls (mod_reliability_observability_baseline mod_tech_budget))
(application :id app.release.publish.registry-login :label "release.yml::registry_login" :kind ci-step :code ".github/workflows/release.yml::Login to GHCR" :calls (mod_release_registry_auth mod_ci_release))
(application :id app.release.publish.metadata :label "release.yml::docker_metadata" :kind ci-step :code ".github/workflows/release.yml::Docker metadata" :calls (mod_release_metadata mod_release_tag_rule))
(application :id app.release.publish.image-push :label "release.yml::image_push" :kind ci-step :code ".github/workflows/release.yml::Build and push Docker image" :calls (mod_release_image_push mod_release_container))
(application :id app.release.publish.native-build :label "release-native.yml::required_builds" :kind reusable-ci-workflow :code ".github/workflows/release-native.yml::{desktop-windows,mobile-android,desktop-macos}" :calls (mod_ci_release mod_release_channel))
(application :id app.release.publish.native-release :label "release-native.yml::validated_publish" :kind ci-job :code ".github/workflows/release-native.yml::publish" :calls (mod_ci_release mod_release_channel))
(application :id app.release.verify.workflow-surface :label "workflow::surface_inspection" :kind repo-inspection :code ".github/workflows/" :calls (mod_ci_workflow))
(application :id app.release.verify.channel-surface :label "release::channel_surface" :kind repo-inspection :code ".github/workflows/release.yml | dist/" :calls (mod_release_channel mod_release_metadata))
(application :id app.release.verify.container-smoke :label "release::container_smoke" :kind deployment-check :code "Dockerfile | docker-compose.yml | ghcr image" :calls (mod_container_delivery mod_release_container))
