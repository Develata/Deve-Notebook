(group :id grp.user.locale-surface-switch :layer user-operation :label "locale surface switch" :members (op.locale.switch.invoke-command-toggle op.locale.switch.select-settings-locale op.locale.switch.apply-locale-context op.locale.switch.observe-rerender))
(user-operation :id op.locale.switch.invoke-command-toggle :label "Invoke Locale Toggle From Command Surface" :kind execute :surface command-palette :code "apps/web/src/components/command_palette/registry.rs::lang" :calls (app.locale.switch.command-toggle))
(user-operation :id op.locale.switch.select-settings-locale :label "Select Locale From Settings" :kind select :surface settings-modal :code "apps/web/src/components/settings.rs" :calls (app.locale.switch.settings-select))
(user-operation :id op.locale.switch.apply-locale-context :label "Apply Locale Context" :kind locale-effect :surface locale-runtime :code "apps/web/src/i18n/mod.rs::Locale | RwSignal<Locale>" :calls (app.locale.switch.apply-context))
(user-operation :id op.locale.switch.observe-rerender :label "Observe Localized Rerender" :kind observe :surface workspace-shell :code "apps/web/src/i18n/ | apps/web/src/components/" :calls (app.locale.switch.render-text))
