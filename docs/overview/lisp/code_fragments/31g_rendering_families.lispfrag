(group :id grp.mod.render-inline-source :layer module :label "rendering inline source reveal" :members (mod_render_hybrid mod_editor_runtime))
(group :id grp.mod.render-projection-refresh :layer module :label "rendering projection refresh" :members (mod_render_inline mod_render_hybrid mod_render_math mod_render_mermaid mod_editor_runtime))
