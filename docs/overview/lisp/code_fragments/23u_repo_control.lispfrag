(group :id grp.app.repo-alias-set :layer application :label "repo alias set" :members (app.repo.alias-set))
(group :id grp.app.repo-alias-transfer :layer application :label "repo alias transfer" :members (app.repo.alias-transfer))
(group :id grp.app.repo-lifecycle :layer application :label "repo lifecycle" :members (app.repo.lifecycle))
(application :id app.repo.alias-set :label "host-local alias CAS intent" :kind host-control :code "apps/web/src/runtime/repo_control_client.rs; apps/cli/src/server/handlers/repo_control.rs; crates/core/src/ledger/manager/host_repo_alias.rs" :calls (mod_proto_ws mod_ledger_manager))
(application :id app.repo.alias-transfer :label "host-local alias JSON transfer" :kind host-control :code "apps/cli/src/commands/repo_alias.rs; crates/core/src/ledger/manager/host_repo_alias/" :calls (mod_ledger_manager))
(application :id app.repo.lifecycle :label "host-owned repo lifecycle job" :kind coordination :code "apps/cli/src/server/runtime/repo_lifecycle_job_runtime/; apps/cli/src/server/runtime/repo_lifecycle_runtime/" :calls (mod_proto_ws mod_ledger_manager mod_remote_import_runtime))
