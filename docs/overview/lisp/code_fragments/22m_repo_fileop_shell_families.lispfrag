(group :id grp.app.repo-fileop-shell :layer application :label "repo file-op shell routing" :members (app.repo.file-shell.detect-mode app.repo.file-shell.parse-query app.repo.file-shell.prefill-destination app.repo.file-shell.build-action))
(application :id app.repo.file-shell.detect-mode :label "file_ops::detect_file_op" :kind ui-callback :code "apps/web/src/components/search_box/{logic/providers.rs,file_ops/mod.rs}" :calls (mod_fileop_shell mod_fileop_parser))
(application :id app.repo.file-shell.parse-query :label "file_ops::parse_args" :kind query-parse :code "apps/web/src/components/search_box/file_ops/parser.rs" :calls (mod_fileop_parser mod_fileop_path_utils))
(application :id app.repo.file-shell.prefill-destination :label "SearchAction::InsertQuery" :kind query-prefill :code "apps/web/src/components/search_box/file_ops/{results_common.rs,results_move_copy.rs}" :calls (mod_fileop_results mod_fileop_path_utils))
(application :id app.repo.file-shell.build-action :label "SearchAction::FileOp" :kind action-build :code "apps/web/src/components/search_box/file_ops/{results_common.rs,results_remove.rs} | apps/web/src/components/search_box/logic/execute.rs" :calls (mod_fileop_results mod_fileop_path_utils mod_search_action_router))
