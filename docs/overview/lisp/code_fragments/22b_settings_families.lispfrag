(group :id grp.app.settings-env :layer application :label "settings env defaults" :members (app.settings.env.defaults app.settings.env.override app.settings.env.inspect))
(group :id grp.app.settings-file :layer application :label "settings file config" :members (app.settings.file.create app.settings.file.edit app.settings.file.apply))
(group :id grp.app.settings-ui :layer application :label "settings UI preferences" :members (app.settings.ui.locale app.settings.ui.theme app.settings.ui.editor-preference app.settings.ui.sync-mode app.settings.ui.ai-backend app.settings.ui.ai-chat-panel))
(group :id grp.app.settings-feedback :layer application :label "settings runtime feedback" :members (app.settings.feedback.visual app.settings.feedback.disabled app.settings.feedback.runtime))
(application :id app.settings.env.defaults :label "config::defaults" :kind config-load :code "crates/core/src/config.rs default_*" :calls (mod_config_defaults mod_config_runtime))
(application :id app.settings.env.override :label "config::env_override" :kind config-load :code "Environment::with_prefix(\"DEVE\")" :calls (mod_config_env mod_config_runtime))
(application :id app.settings.env.inspect :label "runtime::profile_feedback" :kind inspect :code "apps/cli/src/main.rs tracing profile" :calls (mod_config_runtime mod_runtime_profile))
(application :id app.settings.file.create :label "init::write_config" :kind cli-dispatch :code "apps/cli/src/commands/init.rs" :calls (mod_config_file mod_cli_init))
(application :id app.settings.file.edit :label "config::file_value" :kind file-config :code "config::File::with_name(\"config\")" :calls (mod_config_file mod_config_runtime))
(application :id app.settings.file.apply :label "config::load_checked" :kind config-load :code "Config::load_checked" :calls (mod_config_file mod_config_runtime mod_runtime_profile))
(application :id app.settings.ui.locale :label "settings::locale_select" :kind ui-callback :code "SettingsModal locale.set" :calls (mod_settings_ui mod_i18n_catalog))
(application :id app.settings.ui.sync-mode :label "settings::sync_mode_select" :kind ui-callback :code "SyncModeSection on_set_sync_mode" :calls (mod_settings_ui mod_sync_mode_control))
(application :id app.settings.ui.ai-backend :label "settings::ai_backend_select" :kind ui-callback :code "AiBackendSection set_ai_mode" :calls (mod_settings_ui mod_ai_backend_capability))
(application :id app.settings.ui.theme :label "settings::theme_select" :kind ui-callback :code "settings_sections.rs theme controls | settings_prefs.rs" :calls (mod_settings_ui))
(application :id app.settings.ui.editor-preference :label "settings::editor_preference_select" :kind ui-callback :code "settings_sections.rs editor controls | settings_prefs.rs max_document_tabs" :calls (mod_settings_ui))
(application :id app.settings.ui.ai-chat-panel :label "settings::ai_chat_panel_toggle" :kind ui-callback :code "settings_sections.rs chat visibility | settings_prefs.rs" :calls (mod_settings_ui))
(application :id app.settings.feedback.visual :label "settings::visual_feedback" :kind ui-render :code "SettingsModal selected-state rendering" :calls (mod_settings_feedback mod_settings_ui mod_i18n_catalog))
(application :id app.settings.feedback.disabled :label "settings::disabled_reason" :kind ui-render :code "AiBackendSection disabled/title state" :calls (mod_settings_feedback mod_ai_backend_capability))
(application :id app.settings.feedback.runtime :label "settings::runtime_feedback" :kind inspect :code "main.rs profile log | server low-spec behavior" :calls (mod_runtime_profile mod_config_runtime))
