(group :id grp.mod.render-checkbox :layer module :label "rendering checkbox writeback" :members (mod_render_checkbox mod_editor_runtime))
(group :id grp.mod.render-link-activation :layer module :label "rendering link activation gate" :members (mod_link_activation mod_editor_runtime))
(group :id grp.mod.render-outline-navigation :layer module :label "rendering outline navigation" :members (mod_outline_projection mod_editor_runtime))
(module :id mod_render_checkbox :label "render::checkbox" :parent core.rendering :code "apps/web/js/extensions/checkbox_ext.js")
(module :id mod_link_activation :label "link::activation" :parent core.rendering :code "apps/web/js/extensions/hyperlink_click.js | apps/web/src/hooks/use_ctrl_key.rs")
(module :id mod_outline_projection :label "outline::projection" :parent core.rendering :code "apps/web/src/components/outline.rs | apps/web/src/components/outline_render/")
(group :id grp.core.render-checkbox :layer core :label "rendering checkbox writeback" :members (core.rendering core.ledger))
(group :id grp.core.render-link-activation :layer core :label "rendering link activation gate" :members (core.rendering))
(group :id grp.core.render-outline-navigation :layer core :label "rendering outline navigation" :members (core.rendering core.ledger))
