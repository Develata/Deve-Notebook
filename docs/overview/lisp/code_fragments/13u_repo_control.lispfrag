(group :id grp.user.repo-alias-set :layer user-operation :label "repo alias set" :members (op.repo.alias-set.open op.repo.alias-set.submit op.repo.alias-set.render-result))
(group :id grp.user.repo-alias-transfer :layer user-operation :label "repo alias transfer" :members (op.repo.alias-transfer.export op.repo.alias-transfer.preview-import op.repo.alias-transfer.apply-import))
(group :id grp.user.repo-lifecycle :layer user-operation :label "repo lifecycle" :members (op.repo.lifecycle.submit-create op.repo.lifecycle.submit-remove op.repo.lifecycle.prepare-remove op.repo.lifecycle.execute-remove op.repo.lifecycle.query op.repo.lifecycle.publish))
(user-operation :id op.repo.alias-set.open :label "Open Local Alias Editor" :kind open :surface sidebar :code "apps/web/src/components/sidebar/repo_switcher/row/rename_form.rs" :calls (app.repo.alias-set))
(user-operation :id op.repo.alias-set.submit :label "Submit Alias CAS" :kind intent :surface typed-ws :code "apps/web/src/runtime/repo_control_client.rs -> apps/cli/src/server/handlers/repo_control.rs" :calls (app.repo.alias-set))
(user-operation :id op.repo.alias-set.render-result :label "Render Alias Result" :kind projection :surface sidebar :code "apps/web/src/runtime/repo_control_client.rs -> exact RepoList projection" :calls (app.repo.alias-set))
(user-operation :id op.repo.alias-transfer.export :label "Export Host Alias Map" :kind export :surface cli :code "apps/cli/src/commands/repo_alias.rs -> crates/core/src/ledger/manager/host_repo_alias.rs" :calls (app.repo.alias-transfer))
(user-operation :id op.repo.alias-transfer.preview-import :label "Preview Alias Import" :kind preview :surface cli :code "apps/cli/src/commands/repo_alias.rs -> crates/core/src/ledger/manager/host_repo_alias/import.rs" :calls (app.repo.alias-transfer))
(user-operation :id op.repo.alias-transfer.apply-import :label "Apply Alias Import Batch" :kind apply :surface cli :code "apps/cli/src/commands/repo_alias.rs -> crates/core/src/ledger/manager/host_repo_alias/store.rs" :calls (app.repo.alias-transfer))
(user-operation :id op.repo.lifecycle.submit-create :label "Submit Create Job" :kind submit :surface typed-ws :code "apps/cli/src/server/handlers/repo_control.rs -> repo_lifecycle_job_runtime" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.submit-remove :label "Submit Remove Job" :kind submit :surface typed-ws :code "apps/cli/src/server/handlers/repo_control.rs -> repo_lifecycle_job_runtime" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.prepare-remove :label "Prepare Local Removal" :kind drift-missing :surface typed-ws :code "R3 gap: F4/v5 PrepareLocalRepoRemoval not implemented" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.execute-remove :label "Execute Prepared Local Removal" :kind drift-missing :surface typed-ws :code "R3 gap: F4/v5 ExecuteLocalRepoRemoval not implemented" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.query :label "Query Lifecycle Completion" :kind query :surface typed-ws :code "apps/cli/src/server/handlers/repo_control.rs -> repo_lifecycle_job_runtime" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.publish :label "Publish Settled Lifecycle Outcome" :kind coordination :surface backend :code "repo_lifecycle_job_runtime/host.rs -> repo_session_runtime.rs" :calls (app.repo.lifecycle))
