(group :id grp.user.repo-alias-set :layer user-operation :label "repo alias set" :members (op.repo.alias-set.open op.repo.alias-set.submit op.repo.alias-set.render-result))
(group :id grp.user.repo-alias-transfer :layer user-operation :label "repo alias transfer" :members (op.repo.alias-transfer.export op.repo.alias-transfer.preview-import op.repo.alias-transfer.apply-import))
(group :id grp.user.repo-lifecycle :layer user-operation :label "repo lifecycle" :members (op.repo.lifecycle.submit-create op.repo.lifecycle.submit-remove op.repo.lifecycle.query op.repo.lifecycle.publish))
(user-operation :id op.repo.alias-set.open :label "Open Local Alias Editor" :kind drift-missing :surface sidebar :code "planned/no-code-yet" :calls (app.repo.alias-set))
(user-operation :id op.repo.alias-set.submit :label "Submit Alias CAS" :kind drift-missing :surface typed-ws :code "planned/no-code-yet" :calls (app.repo.alias-set))
(user-operation :id op.repo.alias-set.render-result :label "Render Alias Result" :kind drift-missing :surface sidebar :code "planned/no-code-yet" :calls (app.repo.alias-set))
(user-operation :id op.repo.alias-transfer.export :label "Export Host Alias Map" :kind drift-missing :surface cli :code "planned/no-code-yet" :calls (app.repo.alias-transfer))
(user-operation :id op.repo.alias-transfer.preview-import :label "Preview Alias Import" :kind drift-missing :surface cli :code "planned/no-code-yet" :calls (app.repo.alias-transfer))
(user-operation :id op.repo.alias-transfer.apply-import :label "Apply Alias Import Batch" :kind drift-missing :surface cli :code "planned/no-code-yet" :calls (app.repo.alias-transfer))
(user-operation :id op.repo.lifecycle.submit-create :label "Submit Create Job" :kind drift-partial :surface typed-ws :code "handler-owned W7 path; A1 pending" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.submit-remove :label "Submit Remove Job" :kind drift-partial :surface typed-ws :code "handler-owned W7 path; A1/B1 pending" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.query :label "Query Lifecycle Completion" :kind drift-missing :surface typed-ws :code "planned/no-code-yet" :calls (app.repo.lifecycle))
(user-operation :id op.repo.lifecycle.publish :label "Publish Settled Lifecycle Outcome" :kind drift-partial :surface backend :code "apps/cli/src/server/runtime/repo_lifecycle_runtime.rs; immutable cut/settled split pending" :calls (app.repo.lifecycle))
