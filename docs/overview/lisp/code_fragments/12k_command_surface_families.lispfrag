(group :id grp.user.command-surface-mode :layer user-operation :label "command surface mode routing" :members (op.commands.surface.open-unified-search op.commands.surface.type-mode-prefix op.commands.surface.observe-routed-provider))
(group :id grp.user.command-surface-action :layer user-operation :label "command surface action routing" :members (op.commands.surface.choose-result op.commands.surface.dispatch-action op.commands.surface.enter-target-flow))
(user-operation :id op.commands.surface.open-unified-search :label "Open Unified Command Surface" :kind open :surface keyboard-shortcut-or-overlay :code "apps/web/src/components/{command_palette,search_box}/" :calls (app.commands.surface.open))
(user-operation :id op.commands.surface.type-mode-prefix :label "Type Command Mode Prefix" :kind text-input :surface search-input :code "apps/web/src/components/search_box/logic/providers.rs" :calls (app.commands.surface.route-mode))
(user-operation :id op.commands.surface.observe-routed-provider :label "Observe Routed Provider Results" :kind observe :surface search-results :code "apps/web/src/components/search_box/{logic/providers.rs,providers_command.rs,providers_branch.rs,providers_file.rs}" :calls (app.commands.surface.provider-results))
(user-operation :id op.commands.surface.choose-result :label "Choose Routed Result" :kind select :surface keyboard-or-pointer :code "apps/web/src/components/search_box/{logic/selection.rs,ui_sections.rs}" :calls (app.commands.surface.select))
(user-operation :id op.commands.surface.dispatch-action :label "Dispatch SearchAction" :kind dispatch :surface search-surface :code "apps/web/src/components/search_box/{logic/execute.rs,types.rs}" :calls (app.commands.surface.dispatch))
(user-operation :id op.commands.surface.enter-target-flow :label "Enter Routed Target Flow" :kind handoff :surface workspace-shell :code "apps/web/src/components/search_box/logic/execute.rs | apps/web/src/components/command_palette/registry.rs" :calls (app.commands.surface.handoff))
