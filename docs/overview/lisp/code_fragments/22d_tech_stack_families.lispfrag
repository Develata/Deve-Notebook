(group :id grp.app.tech-dependency :layer application :label "tech-stack dependency policy" :members (app.tech.deps.manifest app.tech.deps.lockfile app.tech.deps.evaluate))
(group :id grp.app.tech-budget :layer application :label "tech-stack runtime budget check" :members (app.tech.budget.profile app.tech.budget.check app.tech.budget.gate))
(group :id grp.app.tech-platform :layer application :label "tech-stack platform / release channel" :members (app.tech.platform.matrix app.tech.platform.channel app.tech.platform.container))
(application :id app.tech.deps.manifest :label "deps::manifest_inspection" :kind repo-inspection :code "Cargo.toml | apps/web/package.json" :calls (mod_tech_manifest mod_tech_deps))
(application :id app.tech.deps.lockfile :label "deps::lockfile_inspection" :kind repo-inspection :code "Cargo.lock | apps/web/package-lock.json" :calls (mod_tech_lockfile mod_tech_deps))
(application :id app.tech.deps.evaluate :label "deps::policy_review" :kind review :code "docs/features/14_tech_stack.md | PR review" :calls (mod_tech_policy_review mod_tech_deps mod_runtime_budget))
(application :id app.tech.budget.profile :label "budget::select_profile" :kind config-load :code "DEVE_PROFILE=low-spec | config.toml" :calls (mod_runtime_profile_gate mod_config_runtime))
(application :id app.tech.budget.check :label "budget::runtime_check" :kind check :code "scripts/plan-coverage.sh | .github/workflows/release.yml" :calls (mod_runtime_budget mod_ci_release))
(application :id app.tech.budget.gate :label "budget::heavy_feature_gate" :kind review :code "docs/features/14_tech_stack.md | release checklist" :calls (mod_heavy_feature_gate mod_runtime_budget))
(application :id app.tech.platform.matrix :label "platform::support_matrix" :kind repo-inspection :code "docs/features/{14_tech_stack,15_release}.md" :calls (mod_platform_matrix mod_release_channel))
(application :id app.tech.platform.channel :label "release::channel_verify" :kind check :code ".github/workflows/release.yml | dist/" :calls (mod_release_channel mod_ci_release))
(application :id app.tech.platform.container :label "release::container_verify" :kind check :code "Dockerfile | docker-compose.yml | .github/workflows/release.yml" :calls (mod_container_delivery mod_release_container))
