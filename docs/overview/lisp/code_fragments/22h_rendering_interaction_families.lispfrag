(group :id grp.app.render-checkbox :layer application :label "rendering checkbox writeback" :members (app.render.checkbox.dispatch app.render.checkbox.reflect app.render.checkbox.writeback))
(group :id grp.app.render-link-activation :layer application :label "rendering link activation gate" :members (app.render.link.modifier-state app.render.link.open app.render.link.reset))
(group :id grp.app.render-outline-navigation :layer application :label "rendering outline navigation" :members (app.render.outline.toggle app.render.outline.scroll app.render.outline.render))
(application :id app.render.checkbox.dispatch :label "checkbox::dispatch_toggle" :kind ui-callback :code "apps/web/js/extensions/checkbox_ext.js" :calls (mod_render_checkbox mod_editor_runtime))
(application :id app.render.checkbox.reflect :label "checkbox::reflect_widget" :kind ui-render :code "apps/web/js/extensions/checkbox_ext.js" :calls (mod_render_checkbox))
(application :id app.render.checkbox.writeback :label "checkbox::writeback_source" :kind editor-event :code "apps/web/src/editor/delta_input.rs | apps/web/src/editor/" :calls (mod_editor_runtime mod_render_checkbox))
(application :id app.render.link.modifier-state :label "link::modifier_state" :kind ui-shell :code "apps/web/src/hooks/use_ctrl_key.rs | apps/web/src/components/main_layout.rs" :calls (mod_link_activation))
(application :id app.render.link.open :label "link::guarded_open" :kind editor-event :code "apps/web/js/extensions/hyperlink_click.js" :calls (mod_link_activation mod_editor_runtime))
(application :id app.render.link.reset :label "link::reset_modifier" :kind ui-shell :code "apps/web/src/hooks/use_ctrl_key.rs" :calls (mod_link_activation))
(application :id app.render.outline.toggle :label "outline::toggle" :kind ui-shell :code "apps/web/src/editor/mod.rs | apps/web/src/hooks/use_outline.rs" :calls (mod_outline_projection))
(application :id app.render.outline.scroll :label "outline::scroll_to_heading" :kind ui-callback :code "apps/web/src/components/outline.rs | apps/web/js/editor_adapter.js" :calls (mod_outline_projection mod_editor_runtime))
(application :id app.render.outline.render :label "outline::render_projection" :kind ui-render :code "apps/web/src/components/outline.rs | apps/web/src/components/outline_render/" :calls (mod_outline_projection mod_editor_runtime))
