(group :id grp.user.release-tag :layer user-operation :label "release tag dispatch" :members (op.release.tag.push-semver op.release.tag.match-trigger op.release.tag.observe-dispatch))
(group :id grp.user.release-quality :layer user-operation :label "release quality gates" :members (op.release.quality.start-test-job op.release.quality.run-clippy op.release.quality.check-web-wasm op.release.quality.audit-dependencies op.release.quality.run-tests op.release.quality.run-runtime-happy-path-smoke op.release.quality.run-runtime-recovery-smoke op.release.quality.run-reliability-observability-baseline))
(group :id grp.user.release-publish :layer user-operation :label "release artifact publish" :members (op.release.publish.login-ghcr op.release.publish.compute-tags op.release.publish.smoke-candidate-image op.release.publish.push-image op.release.publish.build-native-artifacts op.release.publish.attach-native-release))
(group :id grp.user.release-verify :layer user-operation :label "release delivery verification" :members (op.release.verify.inspect-workflow-surface op.release.verify.inspect-release-channel op.release.verify.verify-container-delivery))
(user-operation :id op.release.tag.push-semver :label "Push Semver Release Tag" :kind git-event :surface git :code "git push origin vX.Y.Z | .github/workflows/release.yml" :calls (app.release.tag.git-push))
(user-operation :id op.release.tag.match-trigger :label "Match Release Trigger Rule" :kind trigger-check :surface workflow-config :code ".github/workflows/release.yml:on.push.tags" :calls (app.release.tag.trigger-filter))
(user-operation :id op.release.tag.observe-dispatch :label "Observe Workflow Dispatch" :kind observe :surface github-actions :code "GitHub Actions run list" :calls (app.release.tag.workflow-dispatch))
(user-operation :id op.release.quality.start-test-job :label "Start Release Test Job" :kind ci-job :surface github-actions :code ".github/workflows/release.yml::jobs.test" :calls (app.release.quality.test-job))
(user-operation :id op.release.quality.run-clippy :label "Run Clippy Gate" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::Run clippy" :calls (app.release.quality.clippy))
(user-operation :id op.release.quality.check-web-wasm :label "Check Web WASM Target" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::Check web WASM target | apps/web" :calls (app.release.quality.web-wasm))
(user-operation :id op.release.quality.audit-dependencies :label "Audit Dependency Advisories" :kind ci-step :surface github-actions-or-local-script :code ".github/workflows/release.yml::Audit dependencies | scripts/check-release-audit-gate.sh" :calls (app.release.quality.dependency-audit))
(user-operation :id op.release.quality.run-tests :label "Run Test Gate" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::Run tests" :calls (app.release.quality.tests))
(user-operation :id op.release.quality.run-runtime-happy-path-smoke :label "Run Runtime Happy Path Smoke" :kind local-or-ci-script :surface local-or-ci-script :code "scripts/smoke-runtime-happy-path.sh" :calls (app.release.quality.runtime-happy-smoke))
(user-operation :id op.release.quality.run-runtime-recovery-smoke :label "Run Runtime Recovery Smoke" :kind local-or-ci-script :surface local-or-ci-script :code "scripts/smoke-runtime-recovery-path.sh" :calls (app.release.quality.runtime-recovery-smoke))
(user-operation :id op.release.quality.run-reliability-observability-baseline :label "Run Reliability / Observability Governance Baseline" :kind local-or-ci-script :surface github-actions-or-local-script :code "scripts/check-reliability-observability-baseline.sh | tools/baseline/src/reliability_observability.rs" :calls (app.release.quality.reliability-observability-baseline))
(user-operation :id op.release.publish.login-ghcr :label "Login GHCR" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::Login to GHCR" :calls (app.release.publish.registry-login))
(user-operation :id op.release.publish.compute-tags :label "Compute Release Image Tags" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::Docker metadata" :calls (app.release.publish.metadata))
(user-operation :id op.release.publish.smoke-candidate-image :label "Build And Smoke Candidate Image" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::{Build candidate image,Smoke exact candidate image}" :calls (app.release.publish.candidate-smoke))
(user-operation :id op.release.publish.push-image :label "Tag Push And Verify Release Image" :kind ci-step :surface github-actions :code ".github/workflows/release.yml::{Tag and push release image,Verify remote image digests}" :calls (app.release.publish.image-push))
(user-operation :id op.release.publish.build-native-artifacts :label "Build Required Native Artifacts" :kind reusable-ci-workflow :surface github-actions-reusable-workflow :code ".github/workflows/release-native.yml::{desktop-windows,mobile-android,desktop-macos}" :calls (app.release.publish.native-build))
(user-operation :id op.release.publish.attach-native-release :label "Attach Complete Native Artifact Set" :kind ci-job :surface github-actions :code ".github/workflows/release-native.yml::publish" :calls (app.release.publish.native-release))
(user-operation :id op.release.verify.inspect-workflow-surface :label "Inspect Workflow Surface" :kind inspection :surface repo-files :code ".github/workflows/" :calls (app.release.verify.workflow-surface))
(user-operation :id op.release.verify.inspect-release-channel :label "Inspect Release Channel Surface" :kind inspection :surface ci-or-dist :code ".github/workflows/release.yml | dist/" :calls (app.release.verify.channel-surface))
(user-operation :id op.release.verify.verify-container-delivery :label "Verify Container Delivery" :kind check :surface docker :code "Dockerfile | docker-compose.yml | ghcr image" :calls (app.release.verify.container-smoke))
