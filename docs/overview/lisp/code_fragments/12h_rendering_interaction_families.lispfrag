(group :id grp.user.render-checkbox :layer user-operation :label "rendering checkbox writeback" :members (op.render.checkbox.click-toggle op.render.checkbox.observe-widget op.render.checkbox.observe-source))
(group :id grp.user.render-link-activation :layer user-operation :label "rendering link activation gate" :members (op.render.link.press-modifier op.render.link.click-armed-link op.render.link.release-modifier))
(group :id grp.user.render-outline-navigation :layer user-operation :label "rendering outline navigation" :members (op.render.outline.toggle-panel op.render.outline.select-heading op.render.outline.observe-target))
(user-operation :id op.render.checkbox.click-toggle :label "Click Task Checkbox" :kind click :surface editor :code "apps/web/js/extensions/checkbox_ext.js" :calls (app.render.checkbox.dispatch))
(user-operation :id op.render.checkbox.observe-widget :label "Observe Checkbox Widget State" :kind observe :surface editor :code "apps/web/js/extensions/checkbox_ext.js" :calls (app.render.checkbox.reflect))
(user-operation :id op.render.checkbox.observe-source :label "Observe Task Source Writeback" :kind observe :surface editor :code "apps/web/src/editor/delta_input.rs | apps/web/src/editor/" :calls (app.render.checkbox.writeback))
(user-operation :id op.render.link.press-modifier :label "Press Ctrl/Cmd Modifier" :kind keydown :surface workspace-shell :code "apps/web/src/hooks/use_ctrl_key.rs | apps/web/src/components/main_layout.rs" :calls (app.render.link.modifier-state))
(user-operation :id op.render.link.click-armed-link :label "Click Armed Link" :kind click :surface editor :code "apps/web/js/extensions/hyperlink_click.js" :calls (app.render.link.open))
(user-operation :id op.render.link.release-modifier :label "Release Ctrl/Cmd Modifier" :kind keyup :surface workspace-shell :code "apps/web/src/hooks/use_ctrl_key.rs" :calls (app.render.link.reset))
(user-operation :id op.render.outline.toggle-panel :label "Toggle Outline Panel" :kind toggle :surface editor-shell :code "apps/web/src/editor/mod.rs | apps/web/src/hooks/use_outline.rs" :calls (app.render.outline.toggle))
(user-operation :id op.render.outline.select-heading :label "Select Outline Heading" :kind click :surface outline-panel :code "apps/web/src/components/outline.rs" :calls (app.render.outline.scroll))
(user-operation :id op.render.outline.observe-target :label "Observe Editor At Heading Target" :kind observe :surface editor :code "apps/web/src/editor/mod.rs | apps/web/js/editor_adapter.js" :calls (app.render.outline.render))
