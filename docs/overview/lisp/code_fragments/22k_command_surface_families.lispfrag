(group :id grp.app.command-surface-mode :layer application :label "command surface mode routing" :members (app.commands.surface.open app.commands.surface.route-mode app.commands.surface.provider-results))
(group :id grp.app.command-surface-action :layer application :label "command surface action routing" :members (app.commands.surface.select app.commands.surface.dispatch app.commands.surface.handoff))
(application :id app.commands.surface.open :label "search_surface::open" :kind ui-shell :code "apps/web/src/components/{command_palette,search_box}/" :calls ())
(application :id app.commands.surface.route-mode :label "create_results_memo mode router" :kind ui-shell :code "apps/web/src/components/search_box/logic/providers.rs" :calls (mod_search_mode_router mod_command_registry mod_tree_structure))
(application :id app.commands.surface.provider-results :label "SearchProvider::search" :kind ui-shell :code "apps/web/src/components/search_box/{providers_command.rs,providers_branch.rs,providers_file.rs}" :calls (mod_search_mode_router mod_command_registry mod_tree_structure))
(application :id app.commands.surface.select :label "search_result::select" :kind ui-shell :code "apps/web/src/components/search_box/{logic/selection.rs,ui_sections.rs}" :calls ())
(application :id app.commands.surface.dispatch :label "execute_action(SearchAction)" :kind ui-shell :code "apps/web/src/components/search_box/logic/execute.rs" :calls (mod_search_action_router mod_command_registry mod_tree_structure mod_proto_ws))
(application :id app.commands.surface.handoff :label "SearchAction -> downstream flow" :kind ui-shell :code "apps/web/src/components/search_box/{logic/execute.rs,types.rs}" :calls (mod_search_action_router mod_command_registry mod_tree_structure mod_proto_ws))
