(group :id grp.mod.release-tag :layer module :label "release tag dispatch" :members (mod_release_tag_rule mod_ci_trigger mod_ci_workflow))
(group :id grp.mod.release-quality :layer module :label "release quality gates" :members (mod_ci_release mod_quality_test_job mod_quality_clippy mod_quality_web_wasm mod_quality_tests mod_tech_budget))
(group :id grp.mod.release-publish :layer module :label "release artifact publish" :members (mod_release_registry_auth mod_release_metadata mod_release_image_push mod_release_container))
(group :id grp.mod.release-verify :layer module :label "release delivery verification" :members (mod_ci_workflow mod_release_channel mod_container_delivery mod_release_metadata mod_release_container))
(module :id mod_release_tag_rule :label "release::tag_rule" :parent core.release :code ".github/workflows/release.yml tags: ['v*']")
(module :id mod_ci_trigger :label "ci::trigger" :parent core.release :code "GitHub Actions tag dispatch")
(module :id mod_quality_test_job :label "ci::test_job" :parent core.release :code ".github/workflows/release.yml jobs.test")
(module :id mod_quality_clippy :label "quality::clippy" :parent core.release :code ".github/workflows/release.yml Run clippy")
(module :id mod_quality_web_wasm :label "quality::web_wasm" :parent core.release :code ".github/workflows/release.yml wasm32-unknown-unknown / apps/web")
(module :id mod_quality_tests :label "quality::tests" :parent core.release :code ".github/workflows/release.yml Run tests")
(module :id mod_release_registry_auth :label "release::registry_auth" :parent core.release :code ".github/workflows/release.yml Login to GHCR")
(module :id mod_release_metadata :label "release::metadata" :parent core.release :code ".github/workflows/release.yml Docker metadata")
(module :id mod_release_image_push :label "release::image_push" :parent core.release :code ".github/workflows/release.yml Build and push Docker image")
(group :id grp.core.release-tag :layer core :label "release tag dispatch" :members (core.release))
(group :id grp.core.release-quality :layer core :label "release quality gates" :members (core.release core.tech_stack))
(group :id grp.core.release-publish :layer core :label "release artifact publish" :members (core.release))
(group :id grp.core.release-verify :layer core :label "release delivery verification" :members (core.release core.tech_stack))
