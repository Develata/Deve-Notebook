(group :id grp.app.release-ci :layer application :label "release / CI" :members (app.release.ci.dispatch app.release.ci.quality app.release.ci.publish app.release.ci.coverage))
(group :id grp.app.cli-control :layer application :label "CLI control commands" :members (app.cli.control.parse app.cli.control.dispatch app.cli.control.help))
(group :id grp.app.settings-update :layer application :label "settings update" :members (app.settings.open app.settings.change app.settings.feedback))
(group :id grp.app.render-cursor :layer application :label "rendering cursor reveal" :members (app.render.cursor.selection app.render.cursor.delta app.render.cursor.restore))
(group :id grp.app.render-math-mermaid :layer application :label "rendering math / mermaid" :members (app.render.math.source app.render.mermaid.source app.render.projection.refresh))
(group :id grp.app.i18n-locale-error :layer application :label "i18n locale / error" :members (app.i18n.locale.resolve app.i18n.error.map app.i18n.format.resolve))
(group :id grp.app.tech-runtime-budget :layer application :label "tech-stack runtime budget" :members (app.tech.inspect app.tech.budget app.tech.platform))
(application :id app.release.ci.dispatch :label "release.yml::on.push.tags(v*)" :kind ci-dispatch :code ".github/workflows/release.yml" :calls (mod_ci_release mod_ci_workflow))
(application :id app.release.ci.quality :label "release-candidate.yml::validate job" :kind ci-job :code ".github/workflows/release-candidate.yml::jobs.validate" :calls (mod_ci_release mod_tech_budget))
(application :id app.release.ci.publish :label "release.yml::sealed promotion job" :kind ci-job :code ".github/workflows/release.yml::jobs.promote-sealed-candidate" :calls (mod_ci_release mod_release_container))
(application :id app.release.ci.coverage :label "workflow coverage inspection" :kind repo-inspection :code ".github/workflows/" :calls (mod_ci_workflow))
(application :id app.cli.control.parse :label "clap::Commands parse" :kind cli-parser :code "apps/cli/src/main.rs" :calls (mod_cli_dispatch))
(application :id app.cli.control.dispatch :label "dispatch::run" :kind cli-dispatch :code "apps/cli/src/dispatch.rs" :calls (mod_cli_dispatch mod_cli_commands))
(application :id app.cli.control.help :label "clap help surface" :kind cli-help :code "apps/cli/src/main.rs" :calls (mod_cli_dispatch))
(application :id app.settings.open :label "settings::open" :kind ui-shell :code "apps/web/src/components/settings.rs" :calls (mod_settings_ui))
(application :id app.settings.change :label "settings::change_value" :kind ui-or-cli-effect :code "apps/web/src/components/settings_sections.rs | apps/cli/src/dispatch.rs" :calls (mod_settings_ui mod_config_runtime))
(application :id app.settings.feedback :label "settings::feedback" :kind async-result :code "apps/web/src/components/settings.rs | crates/core/src/config.rs" :calls (mod_settings_ui mod_config_runtime mod_i18n_catalog))
(application :id app.render.cursor.selection :label "editor::selection_update" :kind editor-event :code "apps/web/js/extensions/inline_renderer.js | apps/web/src/editor/" :calls (mod_render_inline mod_editor_runtime))
(application :id app.render.cursor.delta :label "editor::delta_input" :kind editor-event :code "apps/web/src/editor/{delta_input.rs,delta_input_forward.rs}" :calls (mod_editor_runtime mod_render_inline))
(application :id app.render.cursor.restore :label "render_projection::restore" :kind render-event :code "apps/web/js/extensions/inline_renderer.js" :calls (mod_render_inline))
(application :id app.render.math.source :label "math source projection" :kind render-event :code "apps/web/js/extensions/inline_renderer.js | apps/web/src/components/outline_render/katex.rs" :calls (mod_render_math mod_editor_runtime))
(application :id app.render.mermaid.source :label "mermaid source projection" :kind render-event :code "apps/web/js/extensions/inline_renderer.js | apps/web/package.json" :calls (mod_render_mermaid mod_editor_runtime))
(application :id app.render.projection.refresh :label "projection refresh from source" :kind render-event :code "apps/web/js/extensions/inline_renderer.js | apps/web/src/editor/delta_input.rs" :calls (mod_render_inline mod_render_math mod_render_mermaid mod_editor_runtime))
(application :id app.i18n.locale.resolve :label "locale::resolve" :kind locale-effect :code "apps/web/src/i18n/ | apps/web/src/components/settings_sections.rs" :calls (mod_i18n_catalog mod_settings_ui))
(application :id app.i18n.error.map :label "server_error::map_code" :kind error-map :code "apps/web/src/i18n/server_error.rs | crates/core/src/protocol/" :calls (mod_i18n_error mod_proto_ws))
(application :id app.i18n.format.resolve :label "time/number format resolve" :kind format-effect :code "apps/web/src/utils/time.rs | apps/web/src/i18n/" :calls (mod_time_format mod_i18n_catalog))
(application :id app.tech.inspect :label "dependency manifest inspection" :kind repo-inspection :code "Cargo.toml | apps/web/package.json" :calls (mod_tech_deps))
(application :id app.tech.budget :label "runtime budget check" :kind check :code "scripts/plan-coverage.sh | .github/workflows/release.yml" :calls (mod_runtime_budget mod_ci_release))
(application :id app.tech.platform :label "platform maturity inspection" :kind repo-inspection :code "docs/features/14_tech_stack.md | docs/features/15_release.md" :calls (mod_platform_matrix mod_release_container))
