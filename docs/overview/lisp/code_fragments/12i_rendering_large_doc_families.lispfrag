(group :id grp.user.render-large-doc-prefetch :layer user-operation :label "rendering large-doc prefetch" :members (op.render.large-doc.open op.render.large-doc.observe-first-screen op.render.large-doc.observe-ready))
(group :id grp.user.render-large-doc-search-gate :layer user-operation :label "rendering large-doc search gate" :members (op.render.large-search.open op.render.large-search.submit-during-load op.render.large-search.submit-after-ready))
(user-operation :id op.render.large-doc.open :label "Open Large Document" :kind open :surface quick-open-or-explorer :code "apps/web/src/editor/hook_open.rs | apps/web/src/editor/sync/snapshot.rs" :calls (app.render.large-doc.open-loading))
(user-operation :id op.render.large-doc.observe-first-screen :label "Observe First Screen During Partial Load" :kind observe :surface editor :code "apps/web/src/editor/sync/snapshot.rs | apps/web/src/editor/sync/snapshot_apply.rs | apps/web/src/components/bottom_bar/stats.rs" :calls (app.render.large-doc.partial-render))
(user-operation :id op.render.large-doc.observe-ready :label "Observe Large Document Ready State" :kind observe :surface editor :code "apps/web/src/editor/sync/history.rs | apps/web/src/editor/sync/snapshot_finish.rs" :calls (app.render.large-doc.ready))
(user-operation :id op.render.large-search.open :label "Open Search While Large Document Loads" :kind open :surface keyboard-shortcut-or-sidebar :code "apps/web/src/components/search_box/mod.rs | apps/web/src/components/main_layout.rs" :calls (app.render.large-search.open))
(user-operation :id op.render.large-search.submit-during-load :label "Submit Search During Partial Load" :kind submit :surface search-input :code "apps/web/src/hooks/use_core/callbacks_misc.rs" :calls (app.render.large-search.gate))
(user-operation :id op.render.large-search.submit-after-ready :label "Submit Search After Load Ready" :kind submit :surface search-input :code "apps/web/src/hooks/use_core/callbacks_misc.rs | apps/cli/src/server/handlers/search.rs" :calls (app.render.large-search.release))
