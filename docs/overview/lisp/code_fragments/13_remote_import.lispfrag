(group :id grp.user.remote-projection-push :layer user-operation :label "remote projection push" :members (op.remote-projection.push.webdav op.remote-projection.push.s3))
(group :id grp.user.remote-import-prepare :layer user-operation :label "remote import prepare" :members (op.remote-import.prepare.webdav op.remote-import.prepare.s3))
(group :id grp.user.remote-import-review :layer user-operation :label "remote import review" :members (op.remote-import.review.list op.remote-import.review.show op.remote-import.review.page op.remote-import.review.diff))
(group :id grp.user.remote-import-apply :layer user-operation :label "remote import apply" :members (op.remote-import.apply.session))
(group :id grp.user.remote-import-manage :layer user-operation :label "remote import manage" :members (op.remote-import.manage.refresh op.remote-import.manage.discard op.remote-import.manage.repair-dry-run op.remote-import.manage.repair-apply))
(user-operation :id op.remote-projection.push.webdav :label "Push Projection through WebDAV" :kind push :surface cli :code "apps/cli/src/remote_projection_transport/webdav/" :calls (app.remote-projection.push))
(user-operation :id op.remote-projection.push.s3 :label "Push Projection through S3" :kind push :surface cli :code "apps/cli/src/remote_projection_transport/s3/" :calls (app.remote-projection.push))
(user-operation :id op.remote-import.prepare.webdav :label "Prepare WebDAV Remote Import" :kind prepare :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> apps/cli/src/remote_projection_transport/webdav/source.rs -> apps/cli/src/remote_import_runtime.rs" :calls (app.remote-import.prepare))
(user-operation :id op.remote-import.prepare.s3 :label "Prepare S3 Remote Import" :kind prepare :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> apps/cli/src/remote_projection_transport/s3/source.rs -> apps/cli/src/remote_import_runtime.rs" :calls (app.remote-import.prepare))
(user-operation :id op.remote-import.review.list :label "List Remote Import Sessions" :kind list :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> crates/core/src/remote_import/facade/" :calls (app.remote-import.review))
(user-operation :id op.remote-import.review.show :label "Show Remote Import Session" :kind show :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> crates/core/src/remote_import/facade/" :calls (app.remote-import.review))
(user-operation :id op.remote-import.review.page :label "Page Remote Import Candidate" :kind page :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> crates/core/src/remote_import/facade/" :calls (app.remote-import.review))
(user-operation :id op.remote-import.review.diff :label "Diff Remote Import Entry" :kind diff :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> crates/core/src/remote_import/facade/" :calls (app.remote-import.review))
(user-operation :id op.remote-import.apply.session :label "Apply Entire Remote Import Session" :kind apply :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> apps/cli/src/remote_import_runtime.rs -> sealed writer" :calls (app.remote-import.apply))
(user-operation :id op.remote-import.manage.refresh :label "Refresh Sealed Candidate" :kind refresh :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> apps/cli/src/remote_import_runtime.rs" :calls (app.remote-import.manage))
(user-operation :id op.remote-import.manage.discard :label "Discard Remote Import Session" :kind discard :surface remote-import :code "apps/web/src/runtime/remote_import_client.rs -> typed WS -> apps/cli/src/remote_import_runtime.rs" :calls (app.remote-import.manage))
(user-operation :id op.remote-import.manage.repair-dry-run :label "Inspect Remote Import Cleanup" :kind repair-plan :surface cli :code "apps/cli/src/commands/remote_import/ -> apps/cli/src/remote_import_runtime.rs" :calls (app.remote-import.manage))
(user-operation :id op.remote-import.manage.repair-apply :label "Apply Remote Import Cleanup" :kind repair-apply :surface cli :code "apps/cli/src/commands/remote_import/ -> apps/cli/src/remote_import_runtime.rs" :calls (app.remote-import.manage))
