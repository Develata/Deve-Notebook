(group :id grp.user.settings-surface :layer user-operation :label "settings surface open" :members (op.settings.surface.open-ui op.settings.surface.open-command op.settings.surface.view-groups))
(group :id grp.user.settings-mutation :layer user-operation :label "settings value mutation" :members (op.settings.mutation.change-ui op.settings.mutation.change-runtime op.settings.mutation.change-cli))
(group :id grp.user.settings-persist :layer user-operation :label "settings persistence / apply" :members (op.settings.persist.write-file op.settings.persist.apply-runtime op.settings.persist.inspect-effective))
(group :id grp.user.settings-feedback-render :layer user-operation :label "settings feedback / render" :members (op.settings.feedback.render-visual op.settings.feedback.render-disabled op.settings.feedback.render-runtime))
(user-operation :id op.settings.surface.open-ui :label "Open Settings From UI" :kind open :surface workspace-shell :code "apps/web/src/components/settings.rs" :calls (app.settings.surface.ui-entry))
(user-operation :id op.settings.surface.open-command :label "Open Settings From Command Surface" :kind open :surface command-surface :code "apps/web/src/components/command_palette/ | apps/web/src/components/settings.rs" :calls (app.settings.surface.command-entry))
(user-operation :id op.settings.surface.view-groups :label "View Settings Groups" :kind observe :surface settings-modal :code "apps/web/src/components/settings_sections.rs" :calls (app.settings.surface.groups))
(user-operation :id op.settings.mutation.change-ui :label "Change UI Setting Value" :kind select :surface settings-modal :code "apps/web/src/components/settings.rs | apps/web/src/components/settings_sections.rs" :calls (app.settings.mutation.ui))
(user-operation :id op.settings.mutation.change-runtime :label "Change Runtime Mode Value" :kind select :surface settings-modal :code "apps/web/src/components/settings_sections.rs" :calls (app.settings.mutation.runtime))
(user-operation :id op.settings.mutation.change-cli :label "Change CLI Config Value" :kind cli-command :surface cli :code "apps/cli/src/dispatch.rs | crates/core/src/config.rs" :calls (app.settings.mutation.cli))
(user-operation :id op.settings.persist.write-file :label "Write Settings File Value" :kind file-edit :surface editor-or-cli :code "crates/core/src/config.rs | apps/cli/src/commands/init.rs" :calls (app.settings.persist.write))
(user-operation :id op.settings.persist.apply-runtime :label "Apply Persisted Config To Runtime" :kind restart :surface restart-or-boot :code "Config::load_checked | apps/cli/src/main.rs" :calls (app.settings.persist.apply))
(user-operation :id op.settings.persist.inspect-effective :label "Inspect Effective Setting State" :kind inspect :surface cli-or-log :code "crates/core/src/config.rs | apps/cli/src/server/mod.rs" :calls (app.settings.persist.inspect))
(user-operation :id op.settings.feedback.render-visual :label "Render Visual Setting Feedback" :kind observe :surface workspace-shell :code "apps/web/src/components/settings.rs" :calls (app.settings.feedback.visual-state))
(user-operation :id op.settings.feedback.render-disabled :label "Render Disabled Setting Reason" :kind observe :surface settings-modal :code "apps/web/src/components/settings_sections.rs" :calls (app.settings.feedback.disabled-state))
(user-operation :id op.settings.feedback.render-runtime :label "Render Runtime Setting Feedback" :kind inspect :surface cli-or-log :code "apps/cli/src/main.rs | apps/cli/src/server/mod.rs" :calls (app.settings.feedback.runtime-state))
