(group :id grp.user.context-action-routing :layer user-operation :label "context action routing" :members (op.ui.context-action.open-menu op.ui.context-action.project-actions op.ui.context-action.choose-action op.ui.context-action.resolve-and-dispatch))
(user-operation :id op.ui.context-action.open-menu :label "Open Context Action Menu" :kind open :surface file-tree-item :code "apps/web/src/components/sidebar_menu/" :calls (app.ui.context-action.open-menu))
(user-operation :id op.ui.context-action.project-actions :label "Project Context Actions" :kind project :surface context-menu :code "apps/web/src/context_action/projection.rs" :calls (app.ui.context-action.project-actions))
(user-operation :id op.ui.context-action.choose-action :label "Choose Context Action" :kind select :surface context-menu :code "apps/web/src/components/sidebar_menu/item.rs | apps/web/src/components/sidebar/item/action.rs" :calls (app.ui.context-action.choose-action))
(user-operation :id op.ui.context-action.resolve-and-dispatch :label "Resolve And Dispatch Context Action" :kind dispatch :surface workspace-shell :code "apps/web/src/components/sidebar/item/action.rs" :calls (app.ui.context-action.resolve-and-dispatch))
(group :id grp.app.context-action-routing :layer application :label "context action routing" :members (app.ui.context-action.open-menu app.ui.context-action.project-actions app.ui.context-action.choose-action app.ui.context-action.resolve-and-dispatch))
(application :id app.ui.context-action.open-menu :label "sidebar_menu::open" :kind ui-shell :code "apps/web/src/components/sidebar_menu/" :calls (mod_context_action_registry mod_context_action_projection))
(application :id app.ui.context-action.project-actions :label "project_context_actions" :kind admission-projection :code "apps/web/src/context_action/projection.rs" :calls (mod_context_action_projection mod_context_action_resolver))
(application :id app.ui.context-action.choose-action :label "ContextActionIntent selected" :kind intent-forward :code "apps/web/src/components/sidebar_menu/item.rs" :calls (mod_sidebar_context_action_handler))
(application :id app.ui.context-action.resolve-and-dispatch :label "resolve_context_action -> dispatch" :kind admission-dispatch :code "apps/web/src/components/sidebar/item/action.rs" :calls (mod_context_action_resolver mod_sidebar_context_action_handler))
(group :id grp.mod.context-action-routing :layer module :label "context action routing" :members (mod_context_action_registry mod_context_action_projection mod_context_action_resolver mod_sidebar_context_action_handler))
(module :id mod_context_action_registry :label "context_action::catalog" :parent core.commands :code "apps/web/src/context_action/catalog.rs")
(module :id mod_context_action_projection :label "context_action::projection" :parent core.commands :code "apps/web/src/context_action/projection.rs")
(module :id mod_context_action_resolver :label "context_action::resolver" :parent core.commands :code "apps/web/src/context_action/resolver.rs")
(module :id mod_sidebar_context_action_handler :label "sidebar::action_handler" :parent core.commands :code "apps/web/src/components/sidebar/item/action.rs | apps/web/src/components/sidebar_menu/")
(group :id grp.core.context-action-routing :layer core :label "context action routing" :members (core.commands core.tree))
