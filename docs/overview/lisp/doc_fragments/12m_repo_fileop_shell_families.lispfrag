(group :id grp.user.repo-fileop-shell :layer user-operation :label "repo file-op shell routing" :members (op.repo.file-shell.enter-command op.repo.file-shell.parse-query op.repo.file-shell.prefill-destination op.repo.file-shell.build-action))
(user-operation :id op.repo.file-shell.enter-command :label "Enter File Operation Command" :kind text-input :surface search-box :chapter 06_repository :feature "docs/features/operations/repo_file_op_shell_routing.md" :calls (app.repo.file-shell.detect-mode))
(user-operation :id op.repo.file-shell.parse-query :label "Parse File Operation Query" :kind query-parse :surface search-input :chapter 06_repository :feature "docs/features/operations/repo_file_op_shell_routing.md" :calls (app.repo.file-shell.parse-query))
(user-operation :id op.repo.file-shell.prefill-destination :label "Prefill File Operation Destination" :kind query-prefill :surface search-results :chapter 08_ui_design :feature "docs/features/operations/repo_file_op_shell_routing.md" :calls (app.repo.file-shell.prefill-destination))
(user-operation :id op.repo.file-shell.build-action :label "Build File Operation Action" :kind dispatch :surface search-results :chapter 06_repository :feature "docs/features/operations/repo_file_op_shell_routing.md" :calls (app.repo.file-shell.build-action))
