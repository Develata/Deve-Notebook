(object :id obj.repo.key :label "repo::key" :kind security-state :authority core.security)
(object :id obj.tree.projection :label "tree::projection" :kind projection :authority core.tree)
(object :id obj.workspace.projection :label "workspace::projection" :kind projection :authority core.sync)
(object :id obj.sc.staging :label "source_control::staging" :kind workflow-state :authority core.source_control)
(object :id obj.sc.pending-fs :label "source_control::pending_fs" :kind workflow-state :authority core.source_control)
(object :id obj.commit :label "commit" :kind version-state :authority core.source_control)
(object :id obj.merge-conflict :label "merge_conflict" :kind conflict-state :authority core.sync)
(object :id obj.auth.session :label "auth::session" :kind security-state :authority core.security)
