(group :id grp.user.command-surface-mode :layer user-operation :label "command surface mode routing" :members (op.commands.surface.open-unified-search op.commands.surface.type-mode-prefix op.commands.surface.observe-routed-provider))
(group :id grp.user.command-surface-action :layer user-operation :label "command surface action routing" :members (op.commands.surface.choose-result op.commands.surface.dispatch-action op.commands.surface.enter-target-flow))
(user-operation :id op.commands.surface.open-unified-search :label "Open Unified Command Surface" :kind open :surface keyboard-shortcut-or-overlay :chapter 14_commands :feature "docs/features/operations/command_surface_mode_routing.md" :calls (app.commands.surface.open))
(user-operation :id op.commands.surface.type-mode-prefix :label "Type Command Mode Prefix" :kind text-input :surface search-input :chapter 14_commands :feature "docs/features/operations/command_surface_mode_routing.md" :calls (app.commands.surface.route-mode))
(user-operation :id op.commands.surface.observe-routed-provider :label "Observe Routed Provider Results" :kind observe :surface search-results :chapter 14_commands :feature "docs/features/operations/command_surface_mode_routing.md" :calls (app.commands.surface.provider-results))
(user-operation :id op.commands.surface.choose-result :label "Choose Routed Result" :kind select :surface keyboard-or-pointer :chapter 14_commands :feature "docs/features/operations/command_surface_action_routing.md" :calls (app.commands.surface.select))
(user-operation :id op.commands.surface.dispatch-action :label "Dispatch SearchAction" :kind dispatch :surface search-surface :chapter 14_commands :feature "docs/features/operations/command_surface_action_routing.md" :calls (app.commands.surface.dispatch))
(user-operation :id op.commands.surface.enter-target-flow :label "Enter Routed Target Flow" :kind handoff :surface workspace-shell :chapter 14_commands :feature "docs/features/operations/command_surface_action_routing.md" :calls (app.commands.surface.handoff))
