(group :id grp.user.cli-projection :layer user-operation :label "CLI projection workspace indexing" :members (op.cli.projection.choose-base op.cli.projection.run-scan op.cli.projection.watch-dry-run))
(group :id grp.user.cli-server :layer user-operation :label "CLI server runtime" :members (op.cli.server.choose-port op.cli.server.enable-dev-mode op.cli.server.dry-run op.cli.server.start))
(group :id grp.user.cli-export :layer user-operation :label "CLI export / inspect" :members (op.cli.inspect.dump-path op.cli.export.choose-format op.cli.export.select-doc op.cli.export.choose-output))
(group :id grp.user.cli-repair :layer user-operation :label "CLI repair / admin" :members (op.cli.admin.verify-p2p op.cli.admin.seed-peer op.cli.admin.check-node op.cli.admin.recover-repo op.cli.admin.repair-paths))
(user-operation :id op.cli.projection.choose-base :label "Choose Projection Base" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_projection_workspace_indexing.md" :calls (app.cli.projection.init))
(user-operation :id op.cli.projection.run-scan :label "Run Projection Scan" :kind cli-command :surface cli :chapter 14_commands :feature "docs/features/operations/cli_projection_workspace_indexing.md" :calls (app.cli.projection.scan))
(user-operation :id op.cli.projection.watch-dry-run :label "Watch Projection Dry Run" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_projection_workspace_indexing.md" :calls (app.cli.projection.watch))
(user-operation :id op.cli.server.choose-port :label "Choose Server Port" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_server_runtime.md" :calls (app.cli.server.bind))
(user-operation :id op.cli.server.enable-dev-mode :label "Enable Dev Mode" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_server_runtime.md" :calls (app.cli.server.dev))
(user-operation :id op.cli.server.dry-run :label "Dry Run Server Startup" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_server_runtime.md" :calls (app.cli.server.dry-run))
(user-operation :id op.cli.server.start :label "Start Local Hub" :kind cli-command :surface cli :chapter 14_commands :feature "docs/features/operations/cli_server_runtime.md" :calls (app.cli.server.start))
(user-operation :id op.cli.inspect.dump-path :label "Dump File Ops" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_export_inspect.md" :calls (app.cli.inspect.dump))
(user-operation :id op.cli.export.choose-format :label "Choose Export Format" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_export_inspect.md" :calls (app.cli.export.format))
(user-operation :id op.cli.export.select-doc :label "Select Export Document" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_export_inspect.md" :calls (app.cli.export.doc))
(user-operation :id op.cli.export.choose-output :label "Choose Export Output" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_export_inspect.md" :calls (app.cli.export.output))
(user-operation :id op.cli.admin.verify-p2p :label "Verify P2P Logic" :kind cli-command :surface cli :chapter 14_commands :feature "docs/features/operations/cli_repair_admin.md" :calls (app.cli.admin.verify-p2p))
(user-operation :id op.cli.admin.seed-peer :label "Seed Peer Data" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_repair_admin.md" :calls (app.cli.admin.seed))
(user-operation :id op.cli.admin.check-node :label "Check Node Consistency" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_repair_admin.md" :calls (app.cli.admin.node-check))
(user-operation :id op.cli.admin.recover-repo :label "Recover Repo Files" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_repair_admin.md" :calls (app.cli.admin.recover))
(user-operation :id op.cli.admin.repair-paths :label "Repair Known Local Corruption" :kind cli-option :surface cli :chapter 14_commands :feature "docs/features/operations/cli_repair_admin.md" :calls (app.cli.admin.repair))
