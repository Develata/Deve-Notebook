(group :id grp.user.settings-surface :layer user-operation :label "settings surface open" :members (op.settings.surface.open-ui op.settings.surface.open-command op.settings.surface.view-groups))
(group :id grp.user.settings-mutation :layer user-operation :label "settings value mutation" :members (op.settings.mutation.change-ui op.settings.mutation.change-runtime op.settings.mutation.change-cli))
(group :id grp.user.settings-persist :layer user-operation :label "settings persistence / apply" :members (op.settings.persist.write-file op.settings.persist.apply-runtime op.settings.persist.inspect-effective))
(group :id grp.user.settings-feedback-render :layer user-operation :label "settings feedback / render" :members (op.settings.feedback.render-visual op.settings.feedback.render-disabled op.settings.feedback.render-runtime))
(user-operation :id op.settings.surface.open-ui :label "Open Settings From UI" :kind open :surface workspace-shell :chapter 15_settings :feature "docs/features/operations/settings_surface_open.md" :calls (app.settings.surface.ui-entry))
(user-operation :id op.settings.surface.open-command :label "Open Settings From Command Surface" :kind open :surface command-surface :chapter 15_settings :feature "docs/features/operations/settings_surface_open.md" :calls (app.settings.surface.command-entry))
(user-operation :id op.settings.surface.view-groups :label "View Settings Groups" :kind observe :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_surface_open.md" :calls (app.settings.surface.groups))
(user-operation :id op.settings.mutation.change-ui :label "Change UI Setting Value" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_value_mutation.md" :calls (app.settings.mutation.ui))
(user-operation :id op.settings.mutation.change-runtime :label "Change Runtime Mode Value" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_value_mutation.md" :calls (app.settings.mutation.runtime))
(user-operation :id op.settings.mutation.change-cli :label "Change CLI Config Value" :kind cli-command :surface cli :chapter 15_settings :feature "docs/features/operations/settings_value_mutation.md" :calls (app.settings.mutation.cli))
(user-operation :id op.settings.persist.write-file :label "Write Settings File Value" :kind file-edit :surface editor-or-cli :chapter 15_settings :feature "docs/features/operations/settings_persistence_apply.md" :calls (app.settings.persist.write))
(user-operation :id op.settings.persist.apply-runtime :label "Apply Persisted Config To Runtime" :kind restart :surface restart-or-boot :chapter 15_settings :feature "docs/features/operations/settings_persistence_apply.md" :calls (app.settings.persist.apply))
(user-operation :id op.settings.persist.inspect-effective :label "Inspect Effective Setting State" :kind inspect :surface cli-or-log :chapter 15_settings :feature "docs/features/operations/settings_persistence_apply.md" :calls (app.settings.persist.inspect))
(user-operation :id op.settings.feedback.render-visual :label "Render Visual Setting Feedback" :kind observe :surface workspace-shell :chapter 15_settings :feature "docs/features/operations/settings_feedback_render.md" :calls (app.settings.feedback.visual-state))
(user-operation :id op.settings.feedback.render-disabled :label "Render Disabled Setting Reason" :kind observe :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_feedback_render.md" :calls (app.settings.feedback.disabled-state))
(user-operation :id op.settings.feedback.render-runtime :label "Render Runtime Setting Feedback" :kind inspect :surface cli-or-log :chapter 15_settings :feature "docs/features/operations/settings_feedback_render.md" :calls (app.settings.feedback.runtime-state))
