(group :id grp.app.locale-surface-switch :layer application :label "locale surface switch" :members (app.locale.switch.command-toggle app.locale.switch.settings-select app.locale.switch.apply-context app.locale.switch.render-text))
(application :id app.locale.switch.command-toggle :label "command_palette::toggle_language" :kind ui-callback :chapter 12_commands :calls (mod_command_registry mod_i18n_locale_context))
(application :id app.locale.switch.settings-select :label "settings::locale_select" :kind ui-callback :chapter 13_settings :calls (mod_settings_ui mod_i18n_locale_context))
(application :id app.locale.switch.apply-context :label "locale::set_context" :kind locale-effect :chapter 11_i18n :calls (mod_i18n_locale_context mod_i18n_catalog))
(application :id app.locale.switch.render-text :label "i18n::rerender_text" :kind ui-render :chapter 11_i18n :calls (mod_i18n_catalog mod_settings_feedback))
