(group :id grp.user.settings-env :layer user-operation :label "settings env defaults" :members (op.settings.env.leave-unset op.settings.env.set-override op.settings.env.inspect-effective))
(group :id grp.user.settings-file :layer user-operation :label "settings file config" :members (op.settings.file.create-default op.settings.file.edit-value op.settings.file.restart-apply))
(group :id grp.user.settings-ui :layer user-operation :label "settings UI preferences" :members (op.settings.ui.modal-focus-lifecycle op.settings.ui.select-language op.settings.ui.select-theme op.settings.ui.select-editor-preference op.settings.ui.select-sync-mode op.settings.ui.select-ai-backend op.settings.ui.toggle-ai-chat-panel))
(group :id grp.user.settings-feedback :layer user-operation :label "settings runtime feedback" :members (op.settings.feedback.observe-visual op.settings.feedback.observe-disabled op.settings.feedback.inspect-runtime))
(user-operation :id op.settings.env.leave-unset :label "Leave Environment Unset" :kind env-default :surface shell :chapter 15_settings :feature "docs/features/operations/settings_env_defaults.md" :calls (app.settings.env.defaults))
(user-operation :id op.settings.env.set-override :label "Set Environment Override" :kind env-override :surface shell :chapter 15_settings :feature "docs/features/operations/settings_env_defaults.md" :calls (app.settings.env.override))
(user-operation :id op.settings.env.inspect-effective :label "Inspect Effective Environment Config" :kind inspect :surface cli-or-log :chapter 15_settings :feature "docs/features/operations/settings_env_defaults.md" :calls (app.settings.env.inspect))
(user-operation :id op.settings.file.create-default :label "Create Default Config File" :kind cli-command :surface cli :chapter 15_settings :feature "docs/features/operations/settings_file_config.md" :calls (app.settings.file.create))
(user-operation :id op.settings.file.edit-value :label "Edit Config File Value" :kind file-edit :surface editor-or-script :chapter 15_settings :feature "docs/features/operations/settings_file_config.md" :calls (app.settings.file.edit))
(user-operation :id op.settings.file.restart-apply :label "Restart To Apply File Config" :kind restart :surface cli-or-process-manager :chapter 15_settings :feature "docs/features/operations/settings_file_config.md" :calls (app.settings.file.apply))
(user-operation :id op.settings.ui.modal-focus-lifecycle :label "Open And Close Settings Modal" :kind modal-lifecycle :surface command-palette-or-settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.surface.command-entry app.settings.surface.ui-entry))
(user-operation :id op.settings.ui.select-language :label "Select UI Language" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.ui.locale))
(user-operation :id op.settings.ui.select-sync-mode :label "Select Sync Mode" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.ui.sync-mode))
(user-operation :id op.settings.ui.select-ai-backend :label "Select AI Backend" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.ui.ai-backend))
(user-operation :id op.settings.ui.select-theme :label "Select Theme Preference" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.ui.theme))
(user-operation :id op.settings.ui.select-editor-preference :label "Select Editor Preference" :kind select :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.ui.editor-preference))
(user-operation :id op.settings.ui.toggle-ai-chat-panel :label "Toggle AI Chat Panel Visibility" :kind toggle :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_ui_preferences.md" :calls (app.settings.ui.ai-chat-panel))
(user-operation :id op.settings.feedback.observe-visual :label "Observe Visual Setting Feedback" :kind observe :surface workspace-shell :chapter 15_settings :feature "docs/features/operations/settings_runtime_feedback.md" :calls (app.settings.feedback.visual))
(user-operation :id op.settings.feedback.observe-disabled :label "Observe Disabled Reserved Setting" :kind observe :surface settings-modal :chapter 15_settings :feature "docs/features/operations/settings_runtime_feedback.md" :calls (app.settings.feedback.disabled))
(user-operation :id op.settings.feedback.inspect-runtime :label "Inspect Runtime Setting Feedback" :kind inspect :surface cli-or-log :chapter 15_settings :feature "docs/features/operations/settings_runtime_feedback.md" :calls (app.settings.feedback.runtime))
