(group :id grp.user.cli-parse-detail :layer user-operation :label "CLI parse command" :members (op.cli.parse.read-argv op.cli.parse.select-subcommand op.cli.parse.observe-typed-command))
(group :id grp.user.cli-help-detail :layer user-operation :label "CLI help surface" :members (op.cli.help.request-root op.cli.help.request-command op.cli.help.scan-surface))
(group :id grp.user.cli-guidance-detail :layer user-operation :label "CLI empty-command guidance" :members (op.cli.guidance.run-without-command op.cli.guidance.observe-help-hint))
(group :id grp.user.cli-runtime-detail :layer user-operation :label "CLI runtime handoff" :members (op.cli.runtime.load-config op.cli.runtime.handoff-dispatch op.cli.runtime.enter-command-module))
(user-operation :id op.cli.parse.read-argv :label "Read CLI Argv" :kind cli-invoke :surface cli :chapter 14_commands :feature "docs/features/operations/cli_parse_command.md" :calls (app.cli.parse.argv))
(user-operation :id op.cli.parse.select-subcommand :label "Select Typed Subcommand" :kind cli-parse :surface cli :chapter 14_commands :feature "docs/features/operations/cli_parse_command.md" :calls (app.cli.parse.subcommand))
(user-operation :id op.cli.parse.observe-typed-command :label "Observe Typed Command Envelope" :kind observe :surface cli :chapter 14_commands :feature "docs/features/operations/cli_parse_command.md" :calls (app.cli.parse.typed-command))
(user-operation :id op.cli.help.request-root :label "Request Root Help" :kind help :surface cli :chapter 14_commands :feature "docs/features/operations/cli_help_surface.md" :calls (app.cli.help.root))
(user-operation :id op.cli.help.request-command :label "Request Command Help" :kind help :surface cli :chapter 14_commands :feature "docs/features/operations/cli_help_surface.md" :calls (app.cli.help.command))
(user-operation :id op.cli.help.scan-surface :label "Scan Help Surface" :kind observe :surface terminal-output :chapter 14_commands :feature "docs/features/operations/cli_help_surface.md" :calls (app.cli.help.render))
(user-operation :id op.cli.guidance.run-without-command :label "Run CLI Without Subcommand" :kind cli-invoke :surface cli :chapter 14_commands :feature "docs/features/operations/cli_empty_command_guidance.md" :calls (app.cli.guidance.none))
(user-operation :id op.cli.guidance.observe-help-hint :label "Observe Help Hint" :kind observe :surface terminal-output :chapter 14_commands :feature "docs/features/operations/cli_empty_command_guidance.md" :calls (app.cli.guidance.hint))
(user-operation :id op.cli.runtime.load-config :label "Load Runtime Config" :kind runtime-bootstrap :surface cli :chapter 14_commands :feature "docs/features/operations/cli_runtime_handoff.md" :calls (app.cli.runtime.config))
(user-operation :id op.cli.runtime.handoff-dispatch :label "Handoff To Dispatcher" :kind dispatch :surface cli :chapter 14_commands :feature "docs/features/operations/cli_runtime_handoff.md" :calls (app.cli.runtime.dispatch))
(user-operation :id op.cli.runtime.enter-command-module :label "Enter Command Module" :kind execute :surface cli :chapter 14_commands :feature "docs/features/operations/cli_runtime_handoff.md" :calls (app.cli.runtime.module))
