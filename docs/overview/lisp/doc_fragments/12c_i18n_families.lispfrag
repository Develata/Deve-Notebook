(group :id grp.user.i18n-locale :layer user-operation :label "i18n locale selection" :members (op.i18n.locale.use-browser op.i18n.locale.select-explicit op.i18n.locale.fallback-missing))
(group :id grp.user.i18n-error :layer user-operation :label "i18n error mapping" :members (op.i18n.error.receive-auth-code op.i18n.error.receive-sc-code op.i18n.error.render-message))
(group :id grp.user.i18n-format :layer user-operation :label "i18n localized formatting" :members (op.i18n.format.switch-locale op.i18n.format.observe-relative-time op.i18n.format.audit-manual-date))
(group :id grp.user.i18n-audit :layer user-operation :label "i18n hardcoded audit" :members (op.i18n.audit.scan-hardcoded op.i18n.audit.add-key op.i18n.audit.verify-facade))
(user-operation :id op.i18n.locale.use-browser :label "Use Browser Locale" :kind auto-select :surface browser :chapter 11_i18n :feature "docs/features/operations/i18n_locale_selection.md" :calls (app.i18n.locale.detect))
(user-operation :id op.i18n.locale.select-explicit :label "Select Explicit Locale" :kind select :surface settings-modal :chapter 11_i18n :feature "docs/features/operations/i18n_locale_selection.md" :calls (app.i18n.locale.select))
(user-operation :id op.i18n.locale.fallback-missing :label "Fallback Missing Locale" :kind fallback :surface i18n-runtime :chapter 11_i18n :feature "docs/features/operations/i18n_locale_selection.md" :calls (app.i18n.locale.fallback))
(user-operation :id op.i18n.error.receive-auth-code :label "Receive Auth Error Code" :kind async-result :surface api-response :chapter 11_i18n :feature "docs/features/operations/i18n_error_mapping.md" :calls (app.i18n.error.auth-code))
(user-operation :id op.i18n.error.receive-sc-code :label "Receive Source Control Error Code" :kind async-result :surface api-or-websocket :chapter 11_i18n :feature "docs/features/operations/i18n_error_mapping.md" :calls (app.i18n.error.sc-code))
(user-operation :id op.i18n.error.render-message :label "Render Localized Error Message" :kind render :surface workspace-shell :chapter 11_i18n :feature "docs/features/operations/i18n_error_mapping.md" :calls (app.i18n.error.render))
(user-operation :id op.i18n.format.switch-locale :label "Switch Formatting Locale" :kind select :surface settings-modal :chapter 11_i18n :feature "docs/features/operations/i18n_localized_formatting.md" :calls (app.i18n.format.locale))
(user-operation :id op.i18n.format.observe-relative-time :label "Observe Relative Time Format" :kind observe :surface workspace-shell :chapter 11_i18n :feature "docs/features/operations/i18n_localized_formatting.md" :calls (app.i18n.format.relative-time))
(user-operation :id op.i18n.format.audit-manual-date :label "Audit Manual Date Formatting" :kind audit :surface repo-search :chapter 11_i18n :feature "docs/features/operations/i18n_localized_formatting.md" :calls (app.i18n.format.audit))
(user-operation :id op.i18n.audit.scan-hardcoded :label "Scan Hardcoded Visible Text" :kind audit :surface repo-search :chapter 11_i18n :feature "docs/features/operations/i18n_hardcoded_audit.md" :calls (app.i18n.audit.scan))
(user-operation :id op.i18n.audit.add-key :label "Add I18n Key" :kind code-edit :surface code-edit :chapter 11_i18n :feature "docs/features/operations/i18n_hardcoded_audit.md" :calls (app.i18n.audit.key))
(user-operation :id op.i18n.audit.verify-facade :label "Verify I18n Facade Usage" :kind verify :surface repo-search-or-test :chapter 11_i18n :feature "docs/features/operations/i18n_hardcoded_audit.md" :calls (app.i18n.audit.facade))
