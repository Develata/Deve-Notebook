(group :id grp.app.release-tag :layer application :label "release tag dispatch" :members (app.release.tag.git-push app.release.tag.trigger-filter app.release.tag.workflow-dispatch))
(group :id grp.app.release-quality :layer application :label "release quality gates" :members (app.release.quality.test-job app.release.quality.clippy app.release.quality.web-wasm app.release.quality.tests))
(group :id grp.app.release-publish :layer application :label "release artifact publish" :members (app.release.publish.registry-login app.release.publish.metadata app.release.publish.image-push))
(group :id grp.app.release-verify :layer application :label "release delivery verification" :members (app.release.verify.workflow-surface app.release.verify.channel-surface app.release.verify.container-smoke))
(application :id app.release.tag.git-push :label "git::push_tag" :kind git-event :chapter 15_release :calls (mod_release_tag_rule mod_ci_workflow))
(application :id app.release.tag.trigger-filter :label "release.yml::tag_filter" :kind ci-dispatch :chapter 15_release :calls (mod_release_tag_rule mod_ci_trigger))
(application :id app.release.tag.workflow-dispatch :label "release.yml::workflow_dispatch" :kind observe :chapter 15_release :calls (mod_ci_trigger mod_ci_workflow))
(application :id app.release.quality.test-job :label "release.yml::test_job" :kind ci-job :chapter 15_release :calls (mod_ci_release mod_quality_test_job))
(application :id app.release.quality.clippy :label "release.yml::clippy_gate" :kind ci-step :chapter 15_release :calls (mod_quality_clippy mod_tech_budget))
(application :id app.release.quality.web-wasm :label "release.yml::web_wasm_gate" :kind ci-step :chapter 15_release :calls (mod_quality_web_wasm mod_tech_budget))
(application :id app.release.quality.tests :label "release.yml::test_gate" :kind ci-step :chapter 15_release :calls (mod_quality_tests mod_tech_budget))
(application :id app.release.publish.registry-login :label "release.yml::registry_login" :kind ci-step :chapter 15_release :calls (mod_release_registry_auth mod_ci_release))
(application :id app.release.publish.metadata :label "release.yml::docker_metadata" :kind ci-step :chapter 15_release :calls (mod_release_metadata mod_release_tag_rule))
(application :id app.release.publish.image-push :label "release.yml::image_push" :kind ci-step :chapter 15_release :calls (mod_release_image_push mod_release_container))
(application :id app.release.verify.workflow-surface :label "workflow::surface_inspection" :kind repo-inspection :chapter 15_release :calls (mod_ci_workflow))
(application :id app.release.verify.channel-surface :label "release::channel_surface" :kind repo-inspection :chapter 15_release :calls (mod_release_channel mod_release_metadata))
(application :id app.release.verify.container-smoke :label "release::container_smoke" :kind deployment-check :chapter 15_release :calls (mod_container_delivery mod_release_container))
