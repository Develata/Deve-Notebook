(group :id grp.app.settings-env :layer application :label "settings env defaults" :members (app.settings.env.defaults app.settings.env.override app.settings.env.inspect))
(group :id grp.app.settings-file :layer application :label "settings file config" :members (app.settings.file.create app.settings.file.edit app.settings.file.apply))
(group :id grp.app.settings-ui :layer application :label "settings UI preferences" :members (app.settings.ui.locale app.settings.ui.sync-mode app.settings.ui.ai-backend))
(group :id grp.app.settings-feedback :layer application :label "settings runtime feedback" :members (app.settings.feedback.visual app.settings.feedback.disabled app.settings.feedback.runtime))
(application :id app.settings.env.defaults :label "config::defaults" :kind config-load :chapter 13_settings :calls (mod_config_defaults mod_config_runtime))
(application :id app.settings.env.override :label "config::env_override" :kind config-load :chapter 13_settings :calls (mod_config_env mod_config_runtime))
(application :id app.settings.env.inspect :label "runtime::profile_feedback" :kind inspect :chapter 13_settings :calls (mod_config_runtime mod_runtime_profile))
(application :id app.settings.file.create :label "init::write_config" :kind cli-dispatch :chapter 13_settings :calls (mod_config_file mod_cli_init))
(application :id app.settings.file.edit :label "config::file_value" :kind file-config :chapter 13_settings :calls (mod_config_file mod_config_runtime))
(application :id app.settings.file.apply :label "config::load_checked" :kind config-load :chapter 13_settings :calls (mod_config_file mod_config_runtime mod_runtime_profile))
(application :id app.settings.ui.locale :label "settings::locale_select" :kind ui-callback :chapter 13_settings :calls (mod_settings_ui mod_i18n_catalog))
(application :id app.settings.ui.sync-mode :label "settings::sync_mode_select" :kind ui-callback :chapter 13_settings :calls (mod_settings_ui mod_sync_mode_control))
(application :id app.settings.ui.ai-backend :label "settings::ai_backend_select" :kind ui-callback :chapter 13_settings :calls (mod_settings_ui mod_ai_backend_capability))
(application :id app.settings.feedback.visual :label "settings::visual_feedback" :kind ui-render :chapter 13_settings :calls (mod_settings_feedback mod_settings_ui mod_i18n_catalog))
(application :id app.settings.feedback.disabled :label "settings::disabled_reason" :kind ui-render :chapter 13_settings :calls (mod_settings_feedback mod_ai_backend_capability))
(application :id app.settings.feedback.runtime :label "settings::runtime_feedback" :kind inspect :chapter 13_settings :calls (mod_runtime_profile mod_config_runtime))
