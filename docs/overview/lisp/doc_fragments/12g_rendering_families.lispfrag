(group :id grp.user.render-inline-source :layer user-operation :label "rendering inline source reveal" :members (op.render.inline.enter-markup op.render.inline.enter-frontmatter op.render.inline.leave-markup))
(group :id grp.user.render-projection-refresh :layer user-operation :label "rendering projection refresh" :members (op.render.refresh.edit-source op.render.refresh.leave-range op.render.refresh.observe-updated-view))
(group :id grp.user.render-math-source :layer user-operation :label "rendering math source projection" :members (op.render.math.enter-source-range op.render.math.type-latex-source op.render.math.leave-source-range))
(group :id grp.user.render-mermaid-source :layer user-operation :label "rendering mermaid source projection" :members (op.render.mermaid.enter-source-block op.render.mermaid.type-diagram-source op.render.mermaid.leave-source-block))
(user-operation :id op.render.inline.enter-markup :label "Move Cursor Into Inline Markup" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_inline_source_reveal.md" :calls (app.render.inline.selection))
(user-operation :id op.render.inline.enter-frontmatter :label "Move Cursor Into Frontmatter" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_inline_source_reveal.md" :calls (app.render.inline.frontmatter-selection))
(user-operation :id op.render.inline.leave-markup :label "Move Cursor Outside Inline Markup" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_inline_source_reveal.md" :calls (app.render.inline.resume))
(user-operation :id op.render.refresh.edit-source :label "Edit Source Span" :kind text-input :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_projection_refresh.md" :calls (app.render.refresh.delta))
(user-operation :id op.render.refresh.leave-range :label "Leave Edited Render Range" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_projection_refresh.md" :calls (app.render.refresh.recompute))
(user-operation :id op.render.refresh.observe-updated-view :label "Observe Updated Projection" :kind observe :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_projection_refresh.md" :calls (app.render.refresh.observe))
(user-operation :id op.render.math.enter-source-range :label "Move Cursor Into Math Source" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_math_source_projection.md" :calls (app.render.math.selection))
(user-operation :id op.render.math.type-latex-source :label "Type LaTeX Source" :kind text-input :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_math_source_projection.md" :calls (app.render.math.delta))
(user-operation :id op.render.math.leave-source-range :label "Move Cursor Outside Math Source" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_math_source_projection.md" :calls (app.render.math.restore))
(user-operation :id op.render.mermaid.enter-source-block :label "Move Cursor Into Mermaid Source" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_mermaid_source_projection.md" :calls (app.render.mermaid.selection))
(user-operation :id op.render.mermaid.type-diagram-source :label "Type Mermaid Diagram Source" :kind text-input :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_mermaid_source_projection.md" :calls (app.render.mermaid.delta))
(user-operation :id op.render.mermaid.leave-source-block :label "Move Cursor Outside Mermaid Source" :kind cursor-move :surface editor :chapter 03_rendering :feature "docs/features/operations/rendering_mermaid_source_projection.md" :calls (app.render.mermaid.restore))
