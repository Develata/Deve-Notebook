(group :id grp.user.render-large-doc-prefetch :layer user-operation :label "rendering large-doc prefetch" :members (op.render.large-doc.open op.render.large-doc.observe-first-screen op.render.large-doc.observe-ready op.render.large-doc.delta-fallback))
(group :id grp.user.render-large-doc-search-gate :layer user-operation :label "rendering large-doc search gate" :members (op.render.large-search.open op.render.large-search.submit-during-load op.render.large-search.submit-after-ready))
(user-operation :id op.render.large-doc.open :label "Open Large Document" :kind open :surface quick-open-or-explorer :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_prefetch.md" :calls (app.render.large-doc.open-loading))
(user-operation :id op.render.large-doc.observe-first-screen :label "Observe First Screen During Partial Load" :kind observe :surface editor :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_prefetch.md" :calls (app.render.large-doc.partial-render))
(user-operation :id op.render.large-doc.observe-ready :label "Observe Large Document Ready State" :kind observe :surface editor :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_prefetch.md" :calls (app.render.large-doc.ready))
(user-operation :id op.render.large-doc.delta-fallback :label "Fallback From Failed Delta Replay" :kind recovery :surface editor :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_prefetch.md" :calls (app.render.large-doc.delta-fallback))
(user-operation :id op.render.large-search.open :label "Open Search While Large Document Loads" :kind open :surface keyboard-shortcut-or-sidebar :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_search_gate.md" :calls (app.render.large-search.open))
(user-operation :id op.render.large-search.submit-during-load :label "Submit Search During Partial Load" :kind submit :surface search-input :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_search_gate.md" :calls (app.render.large-search.gate))
(user-operation :id op.render.large-search.submit-after-ready :label "Submit Search After Load Ready" :kind submit :surface search-input :chapter 10_rendering :feature "docs/features/operations/rendering_large_doc_search_gate.md" :calls (app.render.large-search.release))
