(group :id grp.app.tech-dependency :layer application :label "tech-stack dependency policy" :members (app.tech.deps.manifest app.tech.deps.lockfile app.tech.deps.evaluate))
(group :id grp.app.tech-budget :layer application :label "tech-stack runtime budget check" :members (app.tech.budget.profile app.tech.budget.check app.tech.budget.gate))
(group :id grp.app.tech-platform :layer application :label "tech-stack platform / release channel" :members (app.tech.platform.matrix app.tech.platform.native-process-adapter app.tech.platform.channel app.tech.platform.container))
(application :id app.tech.deps.manifest :label "tech::dependency_manifest" :kind repo-inspection :chapter 17_tech_stack :calls (mod_tech_deps mod_dependency_policy))
(application :id app.tech.deps.lockfile :label "tech::dependency_lockfile" :kind repo-inspection :chapter 17_tech_stack :calls (mod_tech_lockfile mod_dependency_policy))
(application :id app.tech.deps.evaluate :label "tech::dependency_review" :kind review-gate :chapter 17_tech_stack :calls (mod_dependency_policy mod_runtime_budget_guard))
(application :id app.tech.budget.profile :label "runtime::profile_select" :kind config-load :chapter 17_tech_stack :calls (mod_runtime_budget_guard mod_config_runtime))
(application :id app.tech.budget.check :label "runtime::budget_check" :kind check :chapter 17_tech_stack :calls (mod_runtime_budget_guard mod_ci_release))
(application :id app.tech.budget.gate :label "runtime::heavy_feature_gate" :kind review-gate :chapter 17_tech_stack :calls (mod_runtime_budget_guard mod_dependency_policy))
(application :id app.tech.platform.matrix :label "platform::support_matrix" :kind repo-inspection :chapter 17_tech_stack :calls (mod_platform_matrix mod_release_channel))
(application :id app.tech.platform.native-process-adapter :label "native::adapter_boundary" :kind check :chapter 11_ui_design/02_desktop#desktop-native-adapter-contract :calls (mod_native_process_adapter mod_native_service_supervisor mod_platform_matrix))
(application :id app.tech.platform.channel :label "release::channel_verify" :kind release-check :chapter 18_release :calls (mod_release_channel mod_ci_release))
(application :id app.tech.platform.container :label "release::container_verify" :kind release-check :chapter 18_release :calls (mod_release_container mod_release_channel))
