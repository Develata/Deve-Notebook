(group :id grp.app.render-inline-source :layer application :label "rendering inline source reveal" :members (app.render.inline.selection app.render.inline.frontmatter-selection app.render.inline.resume))
(group :id grp.app.render-projection-refresh :layer application :label "rendering projection refresh" :members (app.render.refresh.delta app.render.refresh.recompute app.render.refresh.observe))
(group :id grp.app.render-math-source :layer application :label "rendering math source projection" :members (app.render.math.selection app.render.math.delta app.render.math.restore))
(group :id grp.app.render-mermaid-source :layer application :label "rendering mermaid source projection" :members (app.render.mermaid.selection app.render.mermaid.delta app.render.mermaid.restore))
(application :id app.render.inline.selection :label "editor::selection_update" :kind editor-event :chapter 03_rendering :calls (mod_render_hybrid mod_editor_runtime))
(application :id app.render.inline.frontmatter-selection :label "frontmatter::selection_update" :kind editor-event :chapter 03_rendering :calls (mod_render_hybrid mod_editor_runtime))
(application :id app.render.inline.resume :label "render_inline::resume_markup" :kind render-event :chapter 03_rendering :calls (mod_render_hybrid))
(application :id app.render.refresh.delta :label "editor::delta_input" :kind editor-event :chapter 03_rendering :calls (mod_editor_runtime mod_render_inline mod_render_hybrid))
(application :id app.render.refresh.recompute :label "render_projection::recompute" :kind render-event :chapter 03_rendering :calls (mod_render_inline mod_render_math mod_render_mermaid mod_render_hybrid mod_editor_runtime))
(application :id app.render.refresh.observe :label "render_projection::observe" :kind ui-render :chapter 03_rendering :calls (mod_render_inline mod_render_math mod_render_mermaid))
(application :id app.render.math.selection :label "math::selection_update" :kind editor-event :chapter 03_rendering :calls (mod_render_math mod_editor_runtime))
(application :id app.render.math.delta :label "math::source_delta" :kind editor-event :chapter 03_rendering :calls (mod_editor_runtime mod_render_math))
(application :id app.render.math.restore :label "math::restore_projection" :kind render-event :chapter 03_rendering :calls (mod_render_math mod_editor_runtime))
(application :id app.render.mermaid.selection :label "mermaid::selection_update" :kind editor-event :chapter 03_rendering :calls (mod_render_mermaid mod_editor_runtime))
(application :id app.render.mermaid.delta :label "mermaid::source_delta" :kind editor-event :chapter 03_rendering :calls (mod_editor_runtime mod_render_mermaid))
(application :id app.render.mermaid.restore :label "mermaid::restore_projection" :kind render-event :chapter 03_rendering :calls (mod_render_mermaid mod_editor_runtime))
