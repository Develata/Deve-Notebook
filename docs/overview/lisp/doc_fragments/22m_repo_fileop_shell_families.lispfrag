(group :id grp.app.repo-fileop-shell :layer application :label "repo file-op shell routing" :members (app.repo.file-shell.detect-mode app.repo.file-shell.parse-query app.repo.file-shell.prefill-destination app.repo.file-shell.build-action))
(application :id app.repo.file-shell.detect-mode :label "file_ops::detect_file_op" :kind ui-callback :chapter 12_commands :calls (mod_fileop_shell mod_fileop_parser))
(application :id app.repo.file-shell.parse-query :label "file_ops::parse_args" :kind query-parse :chapter 12_commands :calls (mod_fileop_parser mod_fileop_path_utils))
(application :id app.repo.file-shell.prefill-destination :label "SearchAction::InsertQuery" :kind query-prefill :chapter 08_ui_design :calls (mod_fileop_results mod_fileop_path_utils))
(application :id app.repo.file-shell.build-action :label "SearchAction::FileOp" :kind action-build :chapter 06_repository :calls (mod_fileop_results mod_fileop_path_utils mod_search_action_router))
