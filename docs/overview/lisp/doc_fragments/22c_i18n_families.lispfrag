(group :id grp.app.i18n-locale :layer application :label "i18n locale selection" :members (app.i18n.locale.detect app.i18n.locale.select app.i18n.locale.fallback))
(group :id grp.app.i18n-error :layer application :label "i18n error mapping" :members (app.i18n.error.auth-code app.i18n.error.sc-code app.i18n.error.render))
(group :id grp.app.i18n-format :layer application :label "i18n localized formatting" :members (app.i18n.format.locale app.i18n.format.relative-time app.i18n.format.audit))
(group :id grp.app.i18n-audit :layer application :label "i18n hardcoded audit" :members (app.i18n.audit.scan app.i18n.audit.key app.i18n.audit.facade))
(application :id app.i18n.locale.detect :label "locale::detect_browser" :kind locale-effect :chapter 13_i18n :calls (mod_i18n_locale_context mod_i18n_catalog))
(application :id app.i18n.locale.select :label "locale::select_explicit" :kind ui-callback :chapter 13_i18n :calls (mod_settings_ui mod_i18n_locale_context mod_i18n_catalog))
(application :id app.i18n.locale.fallback :label "locale::fallback_missing" :kind fallback :chapter 13_i18n :calls (mod_i18n_fallback mod_i18n_catalog))
(application :id app.i18n.error.auth-code :label "auth_error::code" :kind protocol-error :chapter 13_i18n :calls (mod_i18n_error mod_protocol_error_catalog))
(application :id app.i18n.error.sc-code :label "sc_error::code" :kind protocol-error :chapter 13_i18n :calls (mod_i18n_error mod_protocol_error_catalog mod_proto_ws))
(application :id app.i18n.error.render :label "server_error::localized_message" :kind error-map :chapter 13_i18n :calls (mod_i18n_error mod_i18n_catalog))
(application :id app.i18n.format.locale :label "format::locale_context" :kind format-effect :chapter 13_i18n :calls (mod_time_format mod_i18n_locale_context))
(application :id app.i18n.format.relative-time :label "format::relative_time" :kind format-effect :chapter 13_i18n :calls (mod_time_format mod_i18n_catalog))
(application :id app.i18n.format.audit :label "format::manual_audit" :kind audit :chapter 13_i18n :calls (mod_i18n_format_audit mod_time_format))
(application :id app.i18n.audit.scan :label "i18n::scan_hardcoded" :kind audit :chapter 13_i18n :calls (mod_i18n_hardcoded_audit mod_i18n_facade))
(application :id app.i18n.audit.key :label "i18n::add_key" :kind code-edit :chapter 13_i18n :calls (mod_i18n_catalog mod_i18n_facade))
(application :id app.i18n.audit.facade :label "i18n::verify_facade" :kind verify :chapter 13_i18n :calls (mod_i18n_facade mod_i18n_hardcoded_audit))
