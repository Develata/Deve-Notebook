(group :id grp.user.locale-surface-switch :layer user-operation :label "locale surface switch" :members (op.locale.switch.invoke-command-toggle op.locale.switch.select-settings-locale op.locale.switch.apply-locale-context op.locale.switch.observe-rerender))
(user-operation :id op.locale.switch.invoke-command-toggle :label "Invoke Locale Toggle From Command Surface" :kind execute :surface command-palette :chapter 12_commands :feature "docs/features/operations/locale_surface_switch.md" :calls (app.locale.switch.command-toggle))
(user-operation :id op.locale.switch.select-settings-locale :label "Select Locale From Settings" :kind select :surface settings-modal :chapter 13_settings :feature "docs/features/operations/locale_surface_switch.md" :calls (app.locale.switch.settings-select))
(user-operation :id op.locale.switch.apply-locale-context :label "Apply Locale Context" :kind locale-effect :surface locale-runtime :chapter 11_i18n :feature "docs/features/operations/locale_surface_switch.md" :calls (app.locale.switch.apply-context))
(user-operation :id op.locale.switch.observe-rerender :label "Observe Localized Rerender" :kind observe :surface workspace-shell :chapter 11_i18n :feature "docs/features/operations/locale_surface_switch.md" :calls (app.locale.switch.render-text))
