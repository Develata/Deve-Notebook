(group :id grp.app.render-checkbox :layer application :label "rendering checkbox writeback" :members (app.render.checkbox.dispatch app.render.checkbox.reflect app.render.checkbox.writeback))
(group :id grp.app.render-link-activation :layer application :label "rendering link activation gate" :members (app.render.link.modifier-state app.render.link.open app.render.link.reset))
(group :id grp.app.render-outline-navigation :layer application :label "rendering outline navigation" :members (app.render.outline.toggle app.render.outline.scroll app.render.outline.render))
(application :id app.render.checkbox.dispatch :label "checkbox::dispatch_toggle" :kind ui-callback :chapter 03_rendering :calls (mod_render_checkbox mod_editor_runtime))
(application :id app.render.checkbox.reflect :label "checkbox::reflect_widget" :kind ui-render :chapter 03_rendering :calls (mod_render_checkbox))
(application :id app.render.checkbox.writeback :label "checkbox::writeback_source" :kind editor-event :chapter 03_rendering :calls (mod_editor_runtime mod_render_checkbox))
(application :id app.render.link.modifier-state :label "link::modifier_state" :kind ui-shell :chapter 03_rendering :calls (mod_link_activation))
(application :id app.render.link.open :label "link::guarded_open" :kind editor-event :chapter 03_rendering :calls (mod_link_activation mod_editor_runtime))
(application :id app.render.link.reset :label "link::reset_modifier" :kind ui-shell :chapter 03_rendering :calls (mod_link_activation))
(application :id app.render.outline.toggle :label "outline::toggle" :kind ui-shell :chapter 03_rendering :calls (mod_outline_projection))
(application :id app.render.outline.scroll :label "outline::scroll_to_heading" :kind ui-callback :chapter 03_rendering :calls (mod_outline_projection mod_editor_runtime))
(application :id app.render.outline.render :label "outline::render_projection" :kind ui-render :chapter 03_rendering :calls (mod_outline_projection mod_editor_runtime))
