(group :id grp.app.cli-parse-detail :layer application :label "CLI parse command" :members (app.cli.parse.argv app.cli.parse.subcommand app.cli.parse.typed-command))
(group :id grp.app.cli-help-detail :layer application :label "CLI help surface" :members (app.cli.help.root app.cli.help.command app.cli.help.render))
(group :id grp.app.cli-guidance-detail :layer application :label "CLI empty-command guidance" :members (app.cli.guidance.none app.cli.guidance.hint))
(group :id grp.app.cli-runtime-detail :layer application :label "CLI runtime handoff" :members (app.cli.runtime.config app.cli.runtime.dispatch app.cli.runtime.module))
(application :id app.cli.parse.argv :label "Args::parse argv" :kind cli-parser :chapter 14_commands :calls (mod_cli_entry))
(application :id app.cli.parse.subcommand :label "Option<Commands> select" :kind cli-parser :chapter 14_commands :calls (mod_cli_entry))
(application :id app.cli.parse.typed-command :label "typed command envelope" :kind cli-envelope :chapter 14_commands :calls (mod_cli_entry mod_cli_runtime_gateway))
(application :id app.cli.help.root :label "--help root surface" :kind cli-help :chapter 14_commands :calls (mod_cli_help_surface))
(application :id app.cli.help.command :label "<command> --help surface" :kind cli-help :chapter 14_commands :calls (mod_cli_help_surface))
(application :id app.cli.help.render :label "clap usage render" :kind cli-help :chapter 14_commands :calls (mod_cli_help_surface))
(application :id app.cli.guidance.none :label "dispatch::run(None)" :kind cli-dispatch :chapter 14_commands :calls (mod_cli_no_command))
(application :id app.cli.guidance.hint :label "missing command hint" :kind cli-guidance :chapter 14_commands :calls (mod_cli_no_command))
(application :id app.cli.runtime.config :label "Config::load_checked" :kind runtime-bootstrap :chapter 14_commands :calls (mod_config_runtime))
(application :id app.cli.runtime.dispatch :label "dispatch::run(Some(...))" :kind cli-dispatch :chapter 14_commands :calls (mod_cli_runtime_gateway))
(application :id app.cli.runtime.module :label "commands::<family>::run" :kind cli-dispatch :chapter 14_commands :calls (mod_cli_runtime_gateway mod_cli_commands))
