// architecture.dot
// Four-layer operation-first cascade:
// user operation -> application response -> concrete module -> core subsystem
// Generated from docs/overview/graph/fragments/*.dotfrag by scripts/generate-architecture-dot.sh

digraph DeveNoteArchitecture {
    rankdir=TB;
    compound=true;
    splines=true;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=10];
    edge [fontname="sans-serif", fontsize=9, color="#475569"];

    subgraph cluster_user {
        label="Layer 1 - User Operation";
        style="filled,rounded";
        fillcolor="#fef3c7";
        color="#92400e";
        labelfontcolor="#92400e";

        subgraph cluster_user_web {
            label="web";
            style="rounded,filled";
            fillcolor="#fffbeb";
            color="#b45309";
            web_placeholder [label="no modeled web-only options", shape=plaintext, fontcolor="#92400e"];
        }

        subgraph cluster_user_desktop {
            label="desktop";
            style="rounded,filled";
            fillcolor="#fffbeb";
            color="#b45309";
            desktop_placeholder [label="no modeled desktop-only options", shape=plaintext, fontcolor="#92400e"];
        }

        subgraph cluster_user_android {
            label="android";
            style="rounded,filled";
            fillcolor="#fffbeb";
            color="#b45309";
            android_placeholder [label="no modeled android-only options", shape=plaintext, fontcolor="#92400e"];
        }

        subgraph cluster_user_shared_wd {
            label="shared(web,desktop)";
            style="rounded,filled";
            fillcolor="#fef6e7";
            color="#c2410c";

            subgraph cluster_user_login {
                label="login [09_auth]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_login_user [label="Type Username", fillcolor="#fef9c3"];
                op_login_pass [label="Type Password", fillcolor="#fef9c3"];
                op_login_submit [label="Submit Login Form", fillcolor="#fde68a"];
                op_login_result [label="Receive Login Result", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_auth_session {
                label="session-expired / unauthorized [09_auth]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_auth_resume [label="Resume Protected Workspace", fillcolor="#fef9c3"];
                op_auth_request [label="Issue Protected Request", fillcolor="#fde68a"];
                op_auth_unauth [label="Receive Unauthorized Result", fillcolor="#fde68a"];
                op_auth_reauth [label="Enter Reauth Surface", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_palette {
                label="command-palette [12_commands]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_palette_open [label="Open Command Palette", fillcolor="#fef9c3"];
                op_palette_query [label="Type Command Query", fillcolor="#fef9c3"];
                op_palette_nav [label="Navigate Results", fillcolor="#fef9c3"];
                op_palette_exec [label="Execute Selected Command", fillcolor="#fde68a"];
                op_palette_close [label="Close Command Palette", fillcolor="#fef9c3"];
            }
        }

            subgraph cluster_user_branch_switch {
                label="branch-switch [06_repository + 16_web_thin_client_ledger]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_branch_open [label="Open Branch Switcher", fillcolor="#fef9c3"];
                op_branch_choose [label="Choose Branch Target", fillcolor="#fde68a"];
                op_branch_request [label="Request Branch Switch", fillcolor="#fde68a"];
                op_branch_result [label="Receive Switch Result", fillcolor="#fef9c3"];
                gate_switch [label="Switch Gates:\nswitch_nonce > scope_nonce\nrepo scope valid", fillcolor="#fde68a", shape=note];
            }

            subgraph cluster_user_sc_commit {
                label="source-control commit [07_diff_logic]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_sc_focus [label="Focus Commit Input", fillcolor="#fef9c3"];
                op_sc_type [label="Type Commit Message", fillcolor="#fef9c3"];
                op_sc_submit [label="Submit Commit", fillcolor="#fde68a"];
                op_sc_result [label="Receive Commit Result", fillcolor="#fef9c3"];
                gate_sc_write [label="Write Gates:\nsession / readonly / scope / handshake", fillcolor="#fde68a", shape=note];
            }

            subgraph cluster_user_ai_chat {
                label="native ai-chat [10_ai_agent]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_ai_open [label="Open AI Chat Panel", fillcolor="#fef9c3"];
                op_ai_type [label="Type AI Prompt", fillcolor="#fef9c3"];
                op_ai_submit [label="Submit AI Prompt", fillcolor="#fde68a"];
                op_ai_stream [label="Receive AI Stream", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_repo_switch {
                label="repo-switch [06_repository]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_repo_open [label="Open Repo Switcher", fillcolor="#fef9c3"];
                op_repo_choose [label="Choose Repo Target", fillcolor="#fde68a"];
                op_repo_request [label="Request Repo Switch", fillcolor="#fde68a"];
                op_repo_result [label="Receive Repo Scope Rebind", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_sc_stage {
                label="stage / unstage [07_diff_logic]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_sc_stage [label="Stage Change Entry", fillcolor="#fde68a"];
                op_sc_stage_ack [label="Receive Stage Ack", fillcolor="#fef9c3"];
                op_sc_unstage [label="Unstage Change Entry", fillcolor="#fde68a"];
                op_sc_unstage_ack [label="Receive Unstage Ack", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_sc_discard {
                label="discard pending [07_diff_logic]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_sc_discard [label="Request Discard Pending", fillcolor="#fde68a"];
                op_sc_discard_ack [label="Receive Discard Ack", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_sc_discard_file {
                label="discard file [07_diff_logic]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_sc_discard_file [label="Discard Change Entry", fillcolor="#fde68a"];
                op_sc_discard_file_ack [label="Receive Discard File Ack", fillcolor="#fef9c3"];
            }

            subgraph cluster_user_sc_conflict {
                label="resolve conflict [07_diff_logic]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_sc_keep_fs [label="Choose KeepFs", fillcolor="#fde68a"];
                op_sc_keep_ledger [label="Choose KeepLedger", fillcolor="#fde68a"];
                op_sc_conflict_resolved [label="Receive Conflict Resolved", fillcolor="#fef9c3"];
            }

        subgraph cluster_user_shared_all {
            label="shared(all)";
            style="rounded,dashed";
            fillcolor="#fffaf0";
            color="#ea580c";

            subgraph cluster_user_doc {
                label="open-doc [06_repository + 16_web_thin_client_ledger]";
                style="rounded,filled";
                fillcolor="#fff7d6";
                color="#d97706";

                op_doc_open [label="Open Quick Open", fillcolor="#fef9c3"];
                op_doc_query [label="Type File Query", fillcolor="#fef9c3"];
                op_doc_choose [label="Choose Document Result", fillcolor="#fde68a"];
                op_doc_request [label="Request OpenDoc", fillcolor="#fde68a"];
                op_doc_receive [label="Receive Document Content", fillcolor="#fef9c3"];
                gate_scope [label="Scope Gates:\nrepo bound\nscope_nonce valid\nWS connected", fillcolor="#fde68a", shape=note];
            }

            shared_all_placeholder [label="current cross-platform flow bucket", shape=plaintext, fontcolor="#92400e"];
        }

    }

    subgraph cluster_app {
        label="Layer 2 - Application Response";
        style="filled,rounded";
        fillcolor="#dbeafe";
        color="#1e3a8a";
        labelfontcolor="#1e3a8a";

        subgraph cluster_app_login {
            label="login [09_auth]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_login_form [label="login::set_username / set_password", fillcolor="#eff6ff"];
            app_login_submit [label="login::submit", fillcolor="#bfdbfe"];
            app_login_result [label="login::result", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_auth_session {
            label="session-expired / unauthorized [09_auth]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_auth_probe_gate [label="auth_probe::should_run", fillcolor="#eff6ff"];
            app_auth_probe [label="auth_probe::request", fillcolor="#bfdbfe"];
            app_auth_unauth [label="auth::mark_unauthorized", fillcolor="#bfdbfe"];
            app_auth_surface [label="auth::enter_login_surface", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_palette {
            label="command-palette [12_commands]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_palette_shell [label="command_palette::open / query /\nnavigate / close", fillcolor="#eff6ff"];
            app_palette_exec [label="command_palette::execute", fillcolor="#bfdbfe"];
            app_exec_branches [label="Representative targets:\nsc::commit / sc::push / ai::chat", fillcolor="#dbeafe"];
        }

        subgraph cluster_app_branch_switch {
            label="branch-switch [06_repository + 16_web_thin_client_ledger]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_branch_open [label="branch_switch::open", fillcolor="#eff6ff"];
            app_branch_select [label="branch_switch::select", fillcolor="#eff6ff"];
            app_branch_request [label="branch_switch::request", fillcolor="#bfdbfe"];
            app_branch_result [label="branch_switch::result", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_sc_commit {
            label="source-control commit [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_sc_commit_draft [label="sc::commit_draft", fillcolor="#eff6ff"];
            app_sc_commit_gate [label="sc::write_gate", fillcolor="#eff6ff"];
            app_sc_commit_submit [label="sc::commit", fillcolor="#bfdbfe"];
            app_sc_commit_result [label="sc::commit_result", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_ai_chat {
            label="native ai-chat [10_ai_agent]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_ai_panel [label="ai::panel / draft", fillcolor="#eff6ff"];
            app_ai_send [label="ai::send_plugin_call", fillcolor="#bfdbfe"];
            app_ai_stream [label="ai::receive_stream", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_repo_switch {
            label="repo-switch [06_repository]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_repo_menu [label="repo_switcher::menu", fillcolor="#eff6ff"];
            app_repo_select [label="repo_switcher::select", fillcolor="#eff6ff"];
            app_repo_request [label="repo_switch::request", fillcolor="#bfdbfe"];
            app_repo_result [label="repo_switch::result", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_sc_stage {
            label="stage / unstage [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_sc_stage [label="sc::stage", fillcolor="#bfdbfe"];
            app_sc_stage_ack [label="sc::stage_result", fillcolor="#eff6ff"];
            app_sc_unstage [label="sc::unstage", fillcolor="#bfdbfe"];
            app_sc_unstage_ack [label="sc::unstage_result", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_sc_discard {
            label="discard pending [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_sc_discard [label="sync::discard_pending", fillcolor="#bfdbfe"];
            app_sc_discard_ack [label="sync::pending_discarded", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_sc_discard_file {
            label="discard file [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_sc_discard_file [label="sc::discard_file", fillcolor="#bfdbfe"];
            app_sc_discard_file_ack [label="sc::discard_ack", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_sc_conflict {
            label="resolve conflict [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_sc_keep_fs [label="sc::resolve_keep_fs", fillcolor="#bfdbfe"];
            app_sc_keep_ledger [label="sc::resolve_keep_ledger", fillcolor="#bfdbfe"];
            app_sc_conflict_resolved [label="sc::conflict_resolved", fillcolor="#eff6ff"];
        }

        subgraph cluster_app_doc {
            label="open-doc [06_repository + 16_web_thin_client_ledger]";
            style="rounded,filled";
            fillcolor="#edf5ff";
            color="#2563eb";

            app_quick_open [label="quick_open::open / query", fillcolor="#eff6ff"];
            app_doc_select [label="quick_open::select_doc", fillcolor="#eff6ff"];
            app_doc_open [label="editor::open_doc", fillcolor="#bfdbfe"];
            app_doc_receive [label="editor::receive_doc", fillcolor="#eff6ff"];
        }

    }

    subgraph cluster_mod {
        label="Layer 3 - Concrete Module";
        style="filled,rounded";
        fillcolor="#dcfce7";
        color="#14532d";
        labelfontcolor="#14532d";

        subgraph cluster_mod_login {
            label="login [09_auth]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sec_auth [label="security::auth", fillcolor="#f0fdf4"];
            mod_sec_jwt [label="security::jwt", fillcolor="#f0fdf4"];
            mod_proto_auth [label="protocol::auth", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_auth_session {
            label="session-expired / unauthorized [09_auth]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_proto_ws_auth [label="protocol::ws", fillcolor="#f0fdf4"];
            mod_proto_auth_session [label="protocol::auth", fillcolor="#f0fdf4"];
            mod_sec_auth_session [label="security::auth", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_doc {
            label="open-doc [06_repository + 16_web_thin_client_ledger]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_proto_ws [label="protocol::ws", fillcolor="#f0fdf4"];
            mod_tree [label="tree::structure", fillcolor="#f0fdf4"];
            mod_ledger [label="ledger::manager", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_branch_switch {
            label="branch-switch [06_repository + 16_web_thin_client_ledger]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_proto_ws_switch [label="protocol::ws", fillcolor="#f0fdf4"];
            mod_tree_switch [label="tree::structure", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_sc_commit {
            label="source-control commit [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sc_staging [label="source_control::staging", fillcolor="#f0fdf4"];
            mod_sc_commit [label="source_control::commits", fillcolor="#f0fdf4"];
            mod_ledger_commit [label="ledger::manager", fillcolor="#f0fdf4"];
            mod_proto_ws_commit [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_ai_chat {
            label="native ai-chat [10_ai_agent]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_plugin_chat_stream [label="plugin::chat_stream", fillcolor="#f0fdf4"];
            mod_proto_ws_ai [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_repo_switch {
            label="repo-switch [06_repository]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_tree_repo [label="tree::structure", fillcolor="#f0fdf4"];
            mod_ledger_repo [label="ledger::manager", fillcolor="#f0fdf4"];
            mod_proto_ws_repo [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_sc_stage {
            label="stage / unstage [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sc_pending [label="source_control::pending_fs", fillcolor="#f0fdf4"];
            mod_sc_stage_table [label="source_control::staging", fillcolor="#f0fdf4"];
            mod_proto_ws_sc [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_sc_discard {
            label="discard pending [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sync_discard [label="sync::materialize", fillcolor="#f0fdf4"];
            mod_ledger_discard [label="ledger::manager", fillcolor="#f0fdf4"];
            mod_proto_ws_discard [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_sc_discard_file {
            label="discard file [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sc_pending_discard_file [label="source_control::pending_fs", fillcolor="#f0fdf4"];
            mod_sync_discard_file [label="sync::materialize", fillcolor="#f0fdf4"];
            mod_ledger_discard_file [label="ledger::manager", fillcolor="#f0fdf4"];
            mod_proto_ws_discard_file [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_sc_conflict {
            label="resolve conflict [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sc_stage_conflict [label="source_control::staging", fillcolor="#f0fdf4"];
            mod_sc_pending_conflict [label="source_control::pending_fs", fillcolor="#f0fdf4"];
            mod_sync_conflict [label="sync::materialize", fillcolor="#f0fdf4"];
            mod_ledger_conflict [label="ledger::manager", fillcolor="#f0fdf4"];
            mod_proto_ws_conflict [label="protocol::ws", fillcolor="#f0fdf4"];
        }

        subgraph cluster_mod_targets {
            label="command-targets [12_commands]";
            style="rounded,filled";
            fillcolor="#effef3";
            color="#16a34a";

            mod_sc [label="source_control::staging / diff", fillcolor="#f0fdf4"];
            mod_plugin [label="plugin::chat_stream", fillcolor="#f0fdf4"];
