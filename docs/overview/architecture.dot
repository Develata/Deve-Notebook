    }

    subgraph cluster_core {
        label="Layer 4 - Core Subsystem";
        style="filled,rounded";
        fillcolor="#fce7f3";
        color="#831843";
        labelfontcolor="#831843";

        subgraph cluster_core_login {
            label="login [09_auth]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_proto [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
            core_sec [label="security\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_auth_session {
            label="session-expired / unauthorized [09_auth]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_proto_auth_session [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
            core_sec_auth_session [label="security\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_doc {
            label="open-doc [06_repository]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_ledger [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_tree [label="tree\n(projection)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_branch_switch {
            label="branch-switch [06_repository]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_proto_switch [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
            core_tree_switch [label="tree\n(projection)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_sc_commit {
            label="source-control commit [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sc_commit [label="source control\n(workflow)", fillcolor="#fdf2f8"];
            core_ledger_commit [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_proto_commit [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_ai_chat {
            label="native ai-chat [10_ai_agent]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_plugin_ai [label="plugin\n(peripheral)", fillcolor="#fdf2f8"];
            core_proto_ai [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_repo_switch {
            label="repo-switch [06_repository]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_tree_repo [label="tree\n(projection)", fillcolor="#fdf2f8"];
            core_ledger_repo [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_proto_repo [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_sc_stage {
            label="stage / unstage [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sc_stage [label="source control\n(workflow)", fillcolor="#fdf2f8"];
            core_proto_sc [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_sc_discard {
            label="discard pending [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sync_discard [label="sync\n(runtime)", fillcolor="#fdf2f8"];
            core_ledger_discard [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_proto_discard [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_sc_discard_file {
            label="discard file [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sc_discard_file [label="source control\n(workflow)", fillcolor="#fdf2f8"];
            core_sync_discard_file [label="sync\n(runtime)", fillcolor="#fdf2f8"];
            core_ledger_discard_file [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_proto_discard_file [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_sc_conflict {
            label="resolve conflict [07_diff_logic]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sc_conflict [label="source control\n(workflow)", fillcolor="#fdf2f8"];
            core_sync_conflict [label="sync\n(runtime)", fillcolor="#fdf2f8"];
            core_ledger_conflict [label="ledger\n(authority)", fillcolor="#fdf2f8"];
            core_proto_conflict [label="protocol\n(runtime)", fillcolor="#fdf2f8"];
        }

        subgraph cluster_core_targets {
            label="command-targets [12_commands]";
            style="rounded,filled";
            fillcolor="#fff0f7";
            color="#be185d";

            core_sc [label="source_control\n(workflow)", fillcolor="#fdf2f8"];
            core_plugin [label="plugin\n(peripheral)", fillcolor="#fdf2f8"];
        }

    }

    op_login_user -> app_login_form;
    op_login_pass -> app_login_form;
    op_login_submit -> app_login_submit;
    op_login_result -> app_login_result;
    op_auth_resume -> app_auth_probe_gate;
    op_auth_request -> app_auth_probe;
    op_auth_request -> app_auth_unauth;
    op_auth_unauth -> app_auth_unauth;
    op_auth_reauth -> app_auth_surface;
    op_sc_focus -> app_sc_commit_draft;
    op_sc_type -> app_sc_commit_draft;
    op_sc_submit -> gate_sc_write;
    gate_sc_write -> app_sc_commit_gate;
