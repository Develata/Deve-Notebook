    user_cli_no_command_spine -> op_cli_guidance_none [style=dashed, color="#f59e0b"];
    op_cli_guidance_none -> op_cli_guidance_hint [style=dashed, color="#f59e0b"];

    user_cli_runtime_handoff_spine [label="CLI runtime handoff flow", shape=plaintext, fontcolor="#92400e"];
    user_cli_runtime_handoff_spine -> op_cli_runtime_config [style=dashed, color="#f59e0b"];
    op_cli_runtime_config -> op_cli_runtime_dispatch [style=dashed, color="#f59e0b"];
    op_cli_runtime_dispatch -> op_cli_runtime_module [style=dashed, color="#f59e0b"];

    user_command_surface_mode_spine [label="command surface mode routing flow", shape=plaintext, fontcolor="#92400e"];
    user_command_surface_mode_spine -> op_command_surface_open [style=dashed, color="#f59e0b"];
    op_command_surface_open -> op_command_surface_mode [style=dashed, color="#f59e0b"];
    op_command_surface_mode -> op_command_surface_results [style=dashed, color="#f59e0b"];

    user_command_surface_action_spine [label="command surface action routing flow", shape=plaintext, fontcolor="#92400e"];
    user_command_surface_action_spine -> op_command_surface_select [style=dashed, color="#f59e0b"];
    op_command_surface_select -> op_command_surface_dispatch [style=dashed, color="#f59e0b"];
    op_command_surface_dispatch -> op_command_surface_handoff [style=dashed, color="#f59e0b"];

    user_locale_surface_switch_spine [label="locale surface switch flow", shape=plaintext, fontcolor="#92400e"];
    user_locale_surface_switch_spine -> op_locale_command_toggle [style=dashed, color="#f59e0b"];
    op_locale_command_toggle -> op_locale_settings_select [style=dashed, color="#f59e0b"];
    op_locale_settings_select -> op_locale_apply [style=dashed, color="#f59e0b"];
    op_locale_apply -> op_locale_rerender [style=dashed, color="#f59e0b"];

    user_repo_fileop_shell_spine [label="repo file-op shell routing flow", shape=plaintext, fontcolor="#92400e"];
    user_repo_fileop_shell_spine -> op_repo_fileop_enter [style=dashed, color="#f59e0b"];
    op_repo_fileop_enter -> op_repo_fileop_parse [style=dashed, color="#f59e0b"];
    op_repo_fileop_parse -> op_repo_fileop_prefill [style=dashed, color="#f59e0b"];
    op_repo_fileop_prefill -> op_repo_fileop_action [style=dashed, color="#f59e0b"];

    user_context_action_spine [label="context action routing flow", shape=plaintext, fontcolor="#92400e"];
    user_context_action_spine -> op_context_action_open [style=dashed, color="#f59e0b"];
    op_context_action_open -> op_context_action_project [style=dashed, color="#f59e0b"];
    op_context_action_project -> op_context_action_choose [style=dashed, color="#f59e0b"];
    op_context_action_choose -> op_context_action_resolve [style=dashed, color="#f59e0b"];

    // generated drift markers from architecture-diff.md
    // no active drift markers

    subgraph cluster_legend {
        label="Legend";
        style="filled,rounded";
        fillcolor="#f3f4f6";
        fontsize=9;

        legend_op [label="user action", fillcolor="#fef9c3"];
        legend_platform [label="platform wrapper", fillcolor="#fffbeb"];
        legend_intersection [label="platform intersection", fillcolor="#fef6e7"];
        legend_app [label="instruction interface", fillcolor="#eff6ff"];
        legend_mod [label="flow coordination", fillcolor="#f0fdf4"];
        legend_core [label="execution domain", fillcolor="#fdf2f8"];
        legend_object [label="object plane (sidecar)", fillcolor="#f8fafc"];
        legend_owner [label="ownership axis (sidecar)", fillcolor="#f1f5f9"];
        legend_note [label="clean shared baseline;
no active drift markers", fillcolor="#e2e8f0"];
        legend_gate [label="scope / contract gate", fillcolor="#fde68a", shape=note];

        legend_op -> legend_platform -> legend_intersection -> legend_app -> legend_mod -> legend_core [style=invis];
        legend_core -> legend_object -> legend_owner -> legend_note -> legend_gate [style=invis];
    }

}
