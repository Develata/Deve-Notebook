{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deve Notebook",
  "version": "0.1.0",
  "identifier": "dev.deve.notebook",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Deve Notebook",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "shortDescription": "Deve Notebook",
    "longDescription": "A ledger-first collaborative notebook shell.",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
